<%# locals: (tag:, entry:, selected:, autofocus: false) %>

<%# One checkbox per tag: ticking several tags only changes the form, and the
    whole set is saved at once with the "Aceptar" button of the dropdown. %>
<%= content_tag :label,
      id: "#{dom_id(entry, :tag_option)}_#{tag.id}",
      class: "filterable-item flex items-center gap-2 rounded-lg px-2 py-1.5 w-full cursor-pointer hover:bg-container-inset-hover",
      data: { filter_name: tag.name, tag_option: true } do %>
  <%= check_box_tag "tag_ids[]", tag.id, selected,
        id: "#{dom_id(entry, :tag_checkbox)}_#{tag.id}",
        autofocus: autofocus,
        class: "checkbox checkbox--light shrink-0" %>
  <%= render DS::Pill.new(label: tag.name, marker: false, size: :md, custom_color: tag.color, truncate: true) %>
<% end %>
