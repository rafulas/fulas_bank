<%# locals: (tags:, editable:) %>
<% names = tags.map(&:name).join(", ") %>

<%# Fulas Bank: the first tag as a colored dot and its name, plus "+N" when
    there are more. Hovering lists every tag. %>
<%= render DS::Tooltip.new(placement: "top", variant: :surface, html_class: "min-w-0 max-w-full") do |tooltip| %>
  <% tooltip.with_trigger do %>
    <%# Editable summaries sit inside the picker button, which takes focus.
        Read-only ones need their own tab stop so keyboard users can open
        the tooltip with the full names. %>
    <%= tag.span class: ["inline-flex min-w-0 items-center gap-1.5", { "rounded-full focus-ring": !editable }], tabindex: (editable ? nil : 0), data: { tag_summary_compact: true } do %>
      <%= render DS::ColorLabel.new(label: tags.first.name, color: tags.first.color, mark: :dot, size: :sm, title: "") %>
      <% if tags.size > 1 %>
        <span class="shrink-0 rounded-full bg-container-inset px-1.5 text-xs font-medium text-secondary" aria-hidden="true" data-tag-more>+<%= tags.size - 1 %></span>
        <span class="sr-only"><%= t("tags.summary.title", names: names) %></span>
      <% end %>
    <% end %>
  <% end %>
  <ul class="flex flex-col items-start gap-1 py-0.5" data-tag-summary-tooltip>
    <% tags.each do |tag| %>
      <li class="flex max-w-full min-w-0">
        <%= render DS::ColorLabel.new(label: tag.name, color: tag.color, mark: :dot, size: :sm, title: "") %>
      </li>
    <% end %>
  </ul>
<% end %>
