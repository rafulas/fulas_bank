<%# locals: (family:, user:) %>
<%# Fulas Bank: the summary at the top of the left panel, like Bilance's: net
    worth with how it splits, each kind of asset and the debts, and the total
    of the accounts chosen for the movements panel with its last weeks. The
    panel scrolls on its own, apart from the page. %>

<%= turbo_frame_tag "sidebar-summary" do %>
<% cache [ family.build_cache_key("sidebar_summary_v2", invalidate_on_data_updates: true), user.id, user.transactions_panel_account_ids, I18n.locale ], expires_in: 12.hours, skip_digest: true do %>
  <% balance_sheet = family.balance_sheet(user: user) %>
  <% asset_groups = balance_sheet.assets.account_groups.select { |group| group.total.positive? } %>
  <% assets_total = asset_groups.sum(&:total) %>
  <% panel = Transaction::Panel.new(family, user: user) %>

  <div id="sidebar-summary" class="space-y-3 mb-4">
    <div class="bg-container rounded-xl shadow-border-xs p-3 space-y-2">
      <p class="text-xs text-secondary"><%= t(".net_worth") %></p>
      <p class="text-lg font-medium text-primary privacy-sensitive whitespace-nowrap"><%= format_money(balance_sheet.net_worth_money) %></p>
      <% if assets_total.positive? %>
        <div class="flex h-1.5 rounded-full overflow-hidden" role="img" aria-label="<%= t(".split_label") %>">
          <% asset_groups.each do |group| %>
            <div style="width: <%= (group.total / assets_total * 100).round(2) %>%; background-color: <%= group.color %>" title="<%= group.name %>"></div>
          <% end %>
        </div>
      <% end %>
    </div>

    <div>
      <div class="flex justify-between px-1 pb-1 text-xs text-secondary">
        <span><%= t(".asset_kind") %></span>
        <span><%= t(".value") %></span>
      </div>
      <ul class="bg-container rounded-xl shadow-border-xs py-1">
        <% asset_groups.each do |group| %>
          <li class="flex items-center justify-between gap-2 px-3 py-1.5 text-xs">
            <span class="flex items-center gap-2 min-w-0">
              <span class="w-2 h-2 rounded-full shrink-0" style="background-color: <%= group.color %>"></span>
              <span class="truncate text-primary" title="<%= group.name %>"><%= group.name %></span>
            </span>
            <span class="shrink-0 text-primary privacy-sensitive whitespace-nowrap"><%= format_money(group.total_money) %></span>
          </li>
        <% end %>
        <% if balance_sheet.liabilities.total.positive? %>
          <li class="flex items-center justify-between gap-2 px-3 py-1.5 text-xs">
            <span class="flex items-center gap-2 min-w-0">
              <span class="w-2 h-2 rounded-full shrink-0 bg-destructive"></span>
              <span class="truncate text-primary"><%= t(".debts") %></span>
            </span>
            <span class="shrink-0 text-destructive privacy-sensitive whitespace-nowrap"><%= format_money(-balance_sheet.liabilities.total_money) %></span>
          </li>
        <% end %>
      </ul>
    </div>

    <% if panel.accounts.any? %>
      <% weekly = panel.weekly_balances %>
      <div class="bg-container rounded-xl shadow-border-xs p-3 space-y-1">
        <div class="flex items-center justify-between">
          <p class="text-xs text-secondary"><%= t(".total_balance") %></p>
          <%= link_to t(".choose"), edit_transactions_panel_accounts_path, data: { turbo_frame: :modal }, class: "text-xs text-secondary hover:text-primary" %>
        </div>
        <p class="text-lg font-medium text-primary privacy-sensitive whitespace-nowrap"><%= format_money(panel.accounts_total) %></p>
        <% if weekly.size > 1 && weekly.all? { |_, value| value >= 0 } %>
          <%= render DS::Sparkline.new(series: weekly, aria_label: t(".total_balance_chart"), css: "w-full text-primary", label_format: "%-d/%-m") %>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>
<% end %>
