<%# locals: (account:, url:) %>

<%# The loan words the shared fields in its own terms. The balance is what is
    owed today; the opening date is not asked for, because the loan's own
    formalisation date below is when its original principal applies (see
    LoansController#account_params). %>
<%= render "accounts/form", account: account, url: url,
           name_label: t("loans.form.name_label"),
           name_placeholder: t("loans.form.name_placeholder"),
           balance_label: t("loans.form.balance_label"),
           balance_hint: t("loans.form.balance_hint"),
           show_opening_balance_date: false do |form| %>
  <%= form.fields_for :accountable do |loan_form| %>
    <%# What kind of loan it is sits with the account's own fields, straight
        after the balance, above the divider and the loan's terms. %>
    <div>
      <%= loan_form.select :subtype,
                Loan.subtype_options_for_select,
                { label: t("loans.form.subtype"), prompt: t("loans.form.subtype_prompt"), include_blank: t("loans.form.none") } %>
    </div>

    <%= render "shared/ruler", classes: "my-4" %>

    <div class="space-y-2"
         data-controller="loan-rate-changes"
         data-loan-rate-changes-fixed-type-value="<%= Loan::FIXED_RATE_TYPE %>">
      <div class="flex items-center gap-2">
        <%= loan_form.money_field :initial_balance,
                                 label: t("loans.form.initial_balance"),
                                 default_currency: Current.family.currency,
                                 required: true %>
      </div>

      <%# Required when the loan is created: it is the date the original
          principal is anchored to, with today's balance anchored today. %>
      <%= loan_form.date_field :start_date,
                               label: t("loans.form.start_date"),
                               max: Date.current,
                               required: account.new_record?,
                               help_text: t("loans.form.start_date_hint") %>

      <div class="flex items-center gap-2">
        <%# Bounded here rather than validated on Loan: PlaidAccount::Liabilities::StudentLoanProcessor
            writes this column from provider dates, and a term the simulator will not walk is
            answered tolerantly there (no schedule, as for an unknown rate type). %>
        <%= loan_form.number_field :term_months,
                                 label: t("loans.form.term_months"),
                                 placeholder: t("loans.form.term_months_placeholder"),
                                 min: 1,
                                 max: Loan::Simulator::MAX_PERIODS %>
        <%= loan_form.number_field :payment_day,
                                 label: t("loans.form.payment_day"),
                                 placeholder: t("loans.form.payment_day_placeholder"),
                                 min: 1,
                                 max: 31 %>
      </div>

      <div class="flex items-center gap-2">
        <%= loan_form.number_field :interest_rate,
                                 label: t("loans.form.interest_rate"),
                                 placeholder: t("loans.form.interest_rate_placeholder"),
                                 min: 0,
                                 step: 0.005 %>
        <%# A provider can write a rate type the form never offers ("arm"); it
            stays in the list so saving the form keeps it rather than silently
            replacing it with the first option. %>
        <%= loan_form.select :rate_type,
                           loan_rate_type_options(account.loan),
                           { label: t("loans.form.rate_type") },
                           { data: { loan_rate_changes_target: "rateType",
                                     action: "change->loan-rate-changes#toggle" } } %>
      </div>

      <%# The instalment the lender quotes. A fixed loan's schedule holds it as
          given; left blank, the schedule sizes its own level payment. %>
      <%= loan_form.money_field :payment_amount,
                               label: t("loans.form.payment_amount"),
                               default_currency: Current.family.currency %>
      <p class="text-xs text-secondary"><%= t("loans.form.payment_amount_hint") %></p>

      <%# Rate changes only mean something for a loan whose rate can move. The
          section is rendered for every rate type, retained rows included, and
          for fixed it is hidden AND its inputs disabled -- here, server-side,
          not only by the Stimulus controller, so a save without JavaScript
          behaves the same. A disabled input is not submitted, so a fixed loan
          sends no rate_changes key and its recorded changes are retained
          rather than cleared. Switching the select to variable enables and
          reveals the retained rows, and the save resubmits them. The rows sit
          in a disclosure that opens closed, as Additional details does. %>
      <% rate_changes_disabled = !account.loan.variable_rate_type? %>
      <div data-loan-rate-changes-target="section" <%= "hidden" if rate_changes_disabled %>>
        <%= render DS::Disclosure.new(variant: :inline, body_class: "space-y-2 mt-2 pl-4 border-l border-primary") do |disclosure| %>
          <% disclosure.with_summary_content do %>
            <span class="text-sm text-secondary hover:text-primary flex items-center gap-1 py-2">
              <%= icon "chevron-right", size: "sm", class: "group-open:rotate-90 transition-transform" %>
              <%= t("loans.form.rate_changes") %>
            </span>
          <% end %>

          <p class="text-xs text-secondary"><%= t("loans.form.rate_changes_hint") %></p>

          <%# Submitted whenever the section is enabled, so removing the last row
              still sends the key and the writer is called to clear the schedule.
              Without it, "remove them all" would send nothing and silently leave
              them persisted. Disabled with the section: on a fixed loan this
              input alone would otherwise submit and clear the retained rows. %>
          <input type="hidden" name="account[accountable_attributes][rate_changes][]" value=""
                 <%= "disabled" if rate_changes_disabled %>>

          <div data-loan-rate-changes-target="rows" class="space-y-2">
            <% account.loan.rate_change_rows.each do |row| %>
              <%= render "loans/rate_change_row",
                         effective_date: row[:effective_date], rate: row[:rate],
                         disabled: rate_changes_disabled %>
            <% end %>
          </div>

          <p data-loan-rate-changes-target="empty" class="text-xs text-subdued"
             <%= "hidden" if account.loan.rate_change_rows.any? %>>
            <%= t("loans.form.rate_changes_empty") %>
          </p>

          <template data-loan-rate-changes-target="template">
            <%= render "loans/rate_change_row", effective_date: nil, rate: nil %>
          </template>

          <%= render DS::Button.new(text: t("loans.form.rate_change_add"), icon: "plus", variant: "ghost", type: "button",
                                    disabled: rate_changes_disabled, data: { action: "loan-rate-changes#add" }) %>
        <% end %>
      </div>

      <%= render "shared/ruler", classes: "my-4" %>

      <%# The premium many lenders quote beside the instalment. Charged
          alongside it rather than inside it, so it moves the loan's total
          cost without moving its repayment. Quoted either as a fixed yearly
          amount or as a rate on the principal. %>
      <%= loan_form.select :insurance_rate_type,
                           loan_insurance_rate_type_options,
                           { label: t("loans.form.insurance_rate_type"),
                             include_blank: t("loans.form.none") } %>

      <div class="flex items-center gap-2">
        <%= loan_form.money_field :insurance_annual_amount,
                                 label: t("loans.form.insurance_annual_amount"),
                                 default_currency: Current.family.currency %>
        <%= loan_form.number_field :insurance_rate,
                                 label: t("loans.form.insurance_rate"),
                                 placeholder: t("loans.form.insurance_rate_placeholder"),
                                 min: 0,
                                 step: 0.005 %>
      </div>
      <p class="text-xs text-secondary"><%= t("loans.form.insurance_rate_hint") %></p>

      <%= render "shared/ruler", classes: "my-4" %>

      <%# The asset the loan paid for: the car behind a car loan, the home
          behind a mortgage. %>
      <%= loan_form.select :asset_account_id,
                           loan_asset_account_options(Current.family),
                           { label: t("loans.form.asset_account"),
                             include_blank: t("loans.form.none"),
                             help_text: t("loans.form.asset_account_hint") } %>
    </div>
  <% end %>
<% end %>
