<% month_budget = @month_budget %>
<%= render DS::Dialog.new do |dialog| %>
  <% dialog.with_header(title: t(".title", month: l(month_budget.month, format: "%B %Y"))) %>
  <% dialog.with_body do %>
    <%= styled_form_with url: month_plan_budget_path(month: month_budget.month.strftime("%Y-%m")), method: :patch, class: "space-y-4", data: { turbo_frame: :_top } do |form| %>
      <p class="text-sm text-secondary"><%= t(".hint") %></p>

      <div class="space-y-2">
        <% month_budget.categories.each do |category| %>
          <div class="flex items-center gap-3">
            <%= render DS::FilledIcon.new(variant: :solid, icon: category.lucide_icon, hex_color: category.color, size: "sm", rounded: true) %>
            <div class="min-w-0 grow">
              <p class="text-sm text-primary truncate"><%= category.name %></p>
              <% if (average = @averages[category.id]) && average.amount.positive? %>
                <p class="text-xs text-secondary privacy-sensitive"><%= t(".average", amount: format_money(average, precision: 0)) %></p>
              <% end %>
            </div>
            <div class="w-32 shrink-0">
              <%= number_field_tag "amounts[#{category.id}]", (@amounts[category.id]&.positive? ? @amounts[category.id].to_s("F") : nil),
                    step: "0.01", min: 0, placeholder: "0",
                    class: "w-full rounded-md border border-primary bg-container px-2 py-1.5 text-sm text-right text-primary",
                    aria: { label: t(".amount_for", category: category.name) } %>
            </div>
          </div>
        <% end %>
      </div>

      <%= form.submit t(".submit") %>
    <% end %>
  <% end %>
<% end %>
