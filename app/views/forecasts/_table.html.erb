<%# locals: (forecast:, account:, expanded: false, hidden: []) %>
<%# The forecast table: one dense table whose header stays in view while it
    scrolls, with a row opening each month (its result and the balance it
    starts from) followed by that month's lines. %>

<% rows = forecast.ledger(account: account) %>
<%# Fulas Bank: as in the user's spreadsheet, the total, then the cash and the
    savings and investments it is made of, then each account (the main one,
    where most movements go, first), without those hidden in "Editar tabla". %>
<% balance_accounts = account ? [] : ([ forecast.main_account ].compact + (forecast.accounts - [ forecast.main_account ])).reject { |each| hidden.include?(each.id) } %>
<% table_rows = forecast_table_rows(forecast, rows) %>

<%= render DS::Card.new(class: class_names("gap-3", "shadow-none p-0" => expanded)) do %>
  <% unless expanded %>
    <div class="flex flex-wrap items-start justify-between gap-2">
      <div class="space-y-1">
        <h3 class="text-sm font-medium text-primary"><%= t(".title") %></h3>
        <p class="text-xs text-secondary"><%= t(".hint") %></p>
      </div>
      <div class="flex items-center gap-2">
        <%= render DS::Link.new(text: t(".edit_columns"), icon: "columns-3", variant: :outline, size: :sm, href: columns_forecast_path, frame: :modal) %>
        <%= render DS::Link.new(text: t(".expand"), icon: "maximize-2", variant: :outline, size: :sm,
              href: table_forecast_path(request.query_parameters.slice("period", "until", "account_id", "variable")), frame: :modal) %>
        <%= render DS::Link.new(text: t(".add"), icon: "plus", size: :sm, href: new_forecast_item_path, frame: :modal) %>
      </div>
    </div>
  <% end %>

  <% if rows.empty? %>
    <p class="text-sm text-secondary"><%= t(".empty") %></p>
  <% else %>
    <%= render DS::Table.new(
      rows: table_rows,
      dense: true,
      sticky_header: true,
      max_height: expanded ? "max-h-[80vh]" : "max-h-[70vh]",
      label: t(".title"),
      row_class: ->(row) {
        if row.month?
          "bg-container-inset font-medium"
        elsif row.flow.skipped
          "text-secondary line-through"
        end
      }
    ) do |table| %>
      <% table.with_column(t(".date"), class: "whitespace-nowrap") do |row| %>
        <% if row.month? %>
          <span class="text-primary first-letter:uppercase"><%= l(row.month, format: "%B %Y") %></span>
        <% else %>
          <%= l(row.flow.date, format: "%d/%m/%y") %>
        <% end %>
      <% end %>
      <% table.with_column(t(".name")) do |row| %>
        <% if row.month? %>
          <span class="text-xs font-normal text-secondary"><%= t(".month_opening") %></span>
        <% else %>
          <div class="flex items-center gap-1.5 min-w-0 max-w-64">
            <span class="truncate" title="<%= row.flow.name %>"><%= row.flow.name %></span>
            <%= render DS::Pill.new(label: t(".sources.#{row.flow.source}"), tone: forecast_source_tone(row.flow.source), marker: false, size: :sm) %>
            <% if row.flow.skipped %>
              <%= render DS::Pill.new(label: t(".skipped"), tone: :neutral, marker: false, size: :sm) %>
            <% elsif row.flow.adjusted %>
              <%= render DS::Pill.new(label: t(".adjusted"), tone: :warning, marker: false, size: :sm) %>
            <% end %>
          </div>
        <% end %>
      <% end %>
      <% unless account %>
        <% table.with_column(t(".account"), class: "text-secondary whitespace-nowrap") { |row| row.month? ? "" : (row.flow.account&.name || t(".no_account")) } %>
      <% end %>
      <% table.with_column(t(".amount"), numeric: true, class: "privacy-sensitive") do |row| %>
        <% amount = row.month? ? row.net : forecast.user_amount(row.flow) %>
        <span class="<%= amount.negative? ? "text-primary" : "text-success" %>" title="<%= t(".month_net") if row.month? %>"><%= forecast_signed_amount(amount.amount, forecast.currency) %></span>
      <% end %>
      <% table.with_column(account ? account.name : t(".total"), numeric: true, class: "privacy-sensitive font-medium bg-info/10 text-primary") do |row| %>
        <%= account ? format_money(Money.new(row.balances[account.id], account.currency)) : format_money(row.total) %>
      <% end %>
      <% unless account %>
        <% table.with_column(t(".cash"), numeric: true, class: "privacy-sensitive font-medium text-primary bg-info/5") do |row| %>
          <%= format_money(forecast.group_totals(row.balances)["cash"]) %>
        <% end %>
        <% table.with_column(t(".investment"), numeric: true, class: "privacy-sensitive font-medium text-primary bg-info/5") do |row| %>
          <%= format_money(forecast.group_totals(row.balances)["investment"]) %>
        <% end %>
      <% end %>
      <% balance_accounts.each do |balance_account| %>
        <% table.with_column(balance_account.name, numeric: true, class: class_names("privacy-sensitive", balance_account == forecast.main_account ? "text-primary bg-warning/10" : "text-secondary")) do |row| %>
          <%= format_money(Money.new(row.balances[balance_account.id], balance_account.currency)) %>
        <% end %>
      <% end %>
      <% table.with_column("", align: :right) do |row| %>
        <% unless row.month? %>
          <% if row.flow.source == :variable %>
            <%= render DS::Link.new(icon: "calculator", variant: :icon, size: :sm, href: variable_forecast_path(month: row.flow.date.beginning_of_month.iso8601),
                  frame: :modal, aria: { label: t(".breakdown") }, title: t(".breakdown")) %>
          <% end %>
          <%= render DS::Link.new(icon: "pencil", variant: :icon, size: :sm, href: forecast_line_edit_path(row.flow), frame: (row.flow.source.in?(%i[debt_plan card]) ? :_top : :modal), aria: { label: t(".edit") }) %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
