<%# locals: (account:, url:) %>

<%= render "accounts/form", account: account, url: url do |form| %>
  <%= render "shared/ruler", classes: "my-4" %>

  <div class="space-y-2">
    <%= form.fields_for :accountable do |credit_card_form| %>
      <div class="flex items-center gap-2">
        <%= credit_card_form.number_field :available_credit,
                                        label: t("credit_cards.form.available_credit"),
                                        placeholder: t("credit_cards.form.available_credit_placeholder"),
                                        min: 0 %>
      </div>

      <div class="flex items-center gap-2">
        <%= credit_card_form.money_field :minimum_payment,
                                        label: t("credit_cards.form.minimum_payment"),
                                        placeholder: t("credit_cards.form.minimum_payment_placeholder"),
                                        default_currency: Current.family.currency %>

        <%= credit_card_form.number_field :apr,
                                        label: t("credit_cards.form.apr"),
                                        placeholder: t("credit_cards.form.apr_placeholder"),
                                        min: 0,
                                        step: 0.01 %>
      </div>

      <div class="flex items-center gap-2">
        <%= credit_card_form.date_field :expiration_date,
                                      label: t("credit_cards.form.expiration_date") %>
        <%= credit_card_form.number_field :annual_fee,
                                        label: t("credit_cards.form.annual_fee"),
                                        placeholder: t("credit_cards.form.annual_fee_placeholder"),
                                        min: 0 %>
      </div>

      <%# Fulas Bank: the monthly statement (see CreditCard::Cycle). %>
      <%= render "shared/ruler", classes: "my-4" %>
      <p class="text-sm font-medium text-primary"><%= t("credit_cards.form.statement_title") %></p>
      <p class="text-xs text-secondary"><%= t("credit_cards.form.statement_hint") %></p>
      <div class="flex items-center gap-2">
        <%= credit_card_form.number_field :statement_closing_day,
                                        label: t("credit_cards.form.statement_closing_day"),
                                        placeholder: "31", min: 1, max: 31 %>
        <%= credit_card_form.number_field :payment_day,
                                        label: t("credit_cards.form.payment_day"),
                                        placeholder: "5", min: 1, max: 31 %>
      </div>
      <div class="flex items-center gap-2">
        <%= credit_card_form.select :payment_account_id,
                                    Current.family.accounts.accessible_by(Current.user).visible
                                           .where(accountable_type: "Depository").alphabetically.map { |each| [ each.name, each.id ] },
                                    { include_blank: t("credit_cards.form.payment_account_none"), label: t("credit_cards.form.payment_account") } %>
        <%= credit_card_form.number_field :consolidation_days,
                                        label: t("credit_cards.form.consolidation_days"),
                                        min: 0, max: 10 %>
      </div>
      <p class="text-xs text-secondary"><%= t("credit_cards.form.consolidation_hint") %></p>
    <% end %>

    <% enable_banking_account = account.provider_account_for("EnableBankingAccount") if account.persisted? %>
    <% if enable_banking_account %>
      <div class="flex items-center justify-between gap-2">
        <div class="space-y-1">
          <p class="text-sm" id="enable_banking_balance_toggle_label"><%= t("credit_cards.form.treat_balance_as_available_credit_label") %></p>
          <p class="text-secondary text-xs"><%= t("credit_cards.form.treat_balance_as_available_credit_description") %></p>
        </div>
        <%= form.fields_for :enable_banking, enable_banking_account do |eb_form| %>
          <%= eb_form.toggle :treat_balance_as_available_credit, "aria-labelledby": "enable_banking_balance_toggle_label" %>
        <% end %>
      </div>
    <% end %>

    <% simplefin_account = account.provider_account_for("SimplefinAccount") if account.persisted? %>
    <% if simplefin_account %>
      <div class="space-y-1">
        <%= form.fields_for :simplefin, simplefin_account do |simplefin_form| %>
          <%= simplefin_form.select :balance_sign_override,
                                    options_for_select([
                                      [t("credit_cards.form.simplefin_balance_sign_auto"), ""],
                                      [t("credit_cards.form.simplefin_balance_sign_debt"), "debt"],
                                      [t("credit_cards.form.simplefin_balance_sign_credit"), "credit"]
                                    ], simplefin_account.balance_sign_override),
                                    { label: t("credit_cards.form.simplefin_balance_sign_label") } %>
        <% end %>
        <p class="text-secondary text-xs"><%= t("credit_cards.form.simplefin_balance_sign_description") %></p>
      </div>
    <% end %>
  </div>
<% end %>
