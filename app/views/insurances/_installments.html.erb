<%# locals: (insurance:) %>
<%# Fulas Bank: the instalments of a policy paid in custom instalments, shown
    when "Personalizado" is chosen. The quick fill creates N instalments of
    the same amount every so many days from the start date; each one can then
    be changed. %>
<div data-insurance-installments-target="custom" class="<%= "hidden" unless insurance.custom_payments? %> space-y-3 rounded-lg border border-secondary p-3">
  <div class="space-y-1">
    <p class="text-sm font-medium text-primary"><%= t("insurances.installments.title") %></p>
    <p class="text-xs text-secondary"><%= t("insurances.installments.hint") %></p>
  </div>

  <div class="grid grid-cols-3 gap-2">
    <div class="form-field">
      <div class="form-field__body">
        <label class="form-field__label"><%= t("insurances.installments.count") %></label>
        <input type="number" min="1" max="<%= Insurance::MAX_INSTALLMENTS %>" value="3" class="form-field__input" data-insurance-installments-target="count">
      </div>
    </div>
    <div class="form-field">
      <div class="form-field__body">
        <label class="form-field__label"><%= t("insurances.installments.every_days") %></label>
        <input type="number" min="1" value="45" class="form-field__input" data-insurance-installments-target="every">
      </div>
    </div>
    <div class="form-field">
      <div class="form-field__body">
        <label class="form-field__label"><%= t("insurances.installments.each_amount") %></label>
        <input type="number" min="0" step="0.01" class="form-field__input" data-insurance-installments-target="amount">
      </div>
    </div>
  </div>
  <%= render DS::Button.new(
        text: t("insurances.installments.fill"),
        icon: "calendar",
        variant: :outline,
        size: :sm,
        data: { action: "insurance-installments#fill" }
      ) %>
  <p class="hidden text-xs text-destructive" data-insurance-installments-target="fillError"><%= t("insurances.installments.fill_error") %></p>

  <div class="space-y-2" data-insurance-installments-target="list">
    <% insurance.installments.each do |row| %>
      <%= render "insurances/installment_row", date: row["date"], amount: row["amount"] %>
    <% end %>
  </div>

  <template data-insurance-installments-target="template">
    <%= render "insurances/installment_row" %>
  </template>

  <div class="form-field">
    <div class="form-field__body">
      <label class="form-field__label" for="insurance_payment_account_id"><%= t("insurances.installments.payment_account") %></label>
      <%= select_tag "insurance[payment_account_id]",
            options_from_collection_for_select(insurance_payment_accounts, :id, :name, insurance.payment_account_id),
            id: "insurance_payment_account_id",
            include_blank: t("insurances.installments.main_account"),
            class: "form-field__input" %>
    </div>
  </div>
  <p class="text-xs text-secondary"><%= t("insurances.installments.forecast_hint") %></p>

  <div class="flex items-center justify-between gap-2">
    <%= render DS::Button.new(
          text: t("insurances.installments.add"),
          icon: "plus",
          variant: :ghost,
          size: :sm,
          data: { action: "insurance-installments#add" }
        ) %>
    <p class="text-xs text-secondary"><%= t("insurances.installments.repeat_hint") %></p>
  </div>
</div>
