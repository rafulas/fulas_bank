<% comparison = @comparison %>
<% through = comparison.base.through %>
<% currency = comparison.currency %>

<% content_for :page_header do %>
  <div class="space-y-1 mb-6">
    <div class="flex items-center gap-2 text-sm">
      <%= link_to t(".back_forecast"), forecast_path, class: "text-secondary hover:text-primary" %>
      <span class="text-subdued">/</span>
      <%= link_to t(".back_scenarios"), forecast_scenarios_path, class: "text-secondary hover:text-primary" %>
    </div>
    <div class="flex items-center gap-2">
      <h1 class="text-xl lg:text-3xl font-medium text-primary"><%= @scenario.name %></h1>
      <%= render DS::Link.new(icon: "pencil", variant: :icon, href: edit_forecast_scenario_path(@scenario), frame: :modal, title: t(".edit")) %>
    </div>
    <p class="text-sm lg:text-base text-secondary"><%= @scenario.notes.presence || t(".subtitle") %></p>
  </div>
<% end %>

<div class="space-y-4 pb-6 lg:pb-12">
  <div class="bg-container rounded-xl shadow-border-xs p-4 space-y-3">
    <div class="flex items-center justify-between gap-2">
      <h2 class="text-sm font-medium text-primary"><%= t(".changes_title") %></h2>
      <%= render DS::Menu.new(variant: "button") do |menu| %>
        <% menu.with_button(text: t(".add_change"), variant: "secondary", size: :sm, icon: "plus") %>
        <% ScenarioChange::KINDS.each do |kind| %>
          <% menu.with_item(variant: "link", text: t(".kinds.#{kind}"), icon: t(".kind_icons.#{kind}"),
                            href: new_forecast_scenario_change_path(@scenario, kind: kind), data: { turbo_frame: :modal }) %>
        <% end %>
      <% end %>
    </div>

    <% if @scenario.scenario_changes.empty? %>
      <p class="text-sm text-secondary"><%= t(".no_changes") %></p>
    <% else %>
      <ul class="divide-y divide-alpha-black-100">
        <% @scenario.scenario_changes.each do |change| %>
          <li class="flex items-center justify-between gap-3 py-2">
            <div class="flex items-start gap-3 min-w-0">
              <%= icon t(".kind_icons.#{change.kind}"), size: "sm", class: "mt-0.5 shrink-0" %>
              <div class="min-w-0">
                <p class="text-sm text-primary"><%= scenario_change_title(change) %></p>
                <p class="text-xs text-secondary"><%= scenario_change_detail(change) %></p>
              </div>
            </div>
            <%= render DS::Menu.new(variant: :icon_sm) do |menu| %>
              <% menu.with_item(variant: "link", text: t(".edit_change"), icon: "pencil-line",
                                href: edit_forecast_scenario_change_path(@scenario, change), data: { turbo_frame: :modal }) %>
              <% menu.with_item(variant: "button", text: t(".delete_change"), icon: "trash-2", destructive: true,
                                href: forecast_scenario_change_path(@scenario, change), method: :delete) %>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>

  <div class="flex flex-wrap items-center gap-2">
    <% ForecastScenariosController::PERIODS.each_key do |period| %>
      <%= render DS::Link.new(text: t(".periods.#{period}"), variant: @period == period ? :primary : :outline, size: :sm,
                              href: forecast_scenario_path(@scenario, period: period)) %>
    <% end %>
  </div>

  <% if @scenario.scenario_changes.any? %>
    <% monthly = comparison.monthly_difference %>
    <% final = comparison.final_difference %>
    <% start = @scenario.starts_on %>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-2">
      <%= summary_card title: t(".monthly", month: l(start.next_month.beginning_of_month, format: "%B %Y")) do %>
        <% if monthly %>
          <span class="<%= scenario_difference_class(monthly) %>"><%= scenario_signed_money(monthly) %></span>
          <span class="block text-xs text-secondary font-normal mt-1"><%= t(".monthly_hint") %></span>
        <% else %>
          —
        <% end %>
      <% end %>
      <%= summary_card title: t(".end_total", date: format_date(through)), tone: :brand do %>
        <%= format_money comparison.scenario_forecast.total_on(through), precision: 0 %>
        <span class="block text-xs text-secondary font-normal mt-1">
          <%= t(".without", amount: format_money(comparison.base.total_on(through), precision: 0)) %>
        </span>
      <% end %>
      <%= summary_card title: t(".final_difference") do %>
        <span class="<%= scenario_difference_class(final) %>"><%= scenario_signed_money(final) %></span>
      <% end %>
      <%= summary_card title: t(".break_even") do %>
        <% if (month = comparison.break_even_month) %>
          <%= l(month, format: "%B %Y") %>
          <span class="block text-xs text-secondary font-normal mt-1"><%= t(".break_even_hint") %></span>
        <% elsif comparison.ever_behind? %>
          <span class="text-destructive"><%= t(".never_catches_up") %></span>
        <% else %>
          <span class="text-success"><%= t(".always_ahead") %></span>
        <% end %>
      <% end %>
    </div>

    <div class="bg-container rounded-xl shadow-border-xs p-4 space-y-2">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <h3 class="text-sm font-medium text-primary"><%= t(".chart_title") %></h3>
        <div class="flex items-center gap-4 text-xs text-secondary">
          <span class="flex items-center gap-1"><span class="inline-block w-4 border-t-2 border-dashed border-secondary"></span><%= t(".legend_base") %></span>
          <span class="flex items-center gap-1"><span class="inline-block w-4 border-t-2 border-success"></span><%= t(".legend_scenario") %></span>
        </div>
      </div>
      <div class="h-64 w-full"
           data-controller="scenario-chart"
           data-scenario-chart-data-value="<%= {
             points: comparison.chart_data,
             currency: currency,
             locale: I18n.locale,
             labels: { base: t(".legend_base"), scenario: t(".legend_scenario"), difference: t(".difference") }
           }.to_json %>"></div>
    </div>

    <div class="bg-container rounded-xl shadow-border-xs overflow-hidden">
      <div class="p-4 pb-2">
        <h3 class="text-sm font-medium text-primary"><%= t(".table_title") %></h3>
        <p class="text-xs text-secondary"><%= t(".table_hint") %></p>
      </div>
      <div class="overflow-auto max-h-[36rem]">
        <table class="w-full text-sm tabular-nums privacy-sensitive">
          <thead class="sticky top-0 bg-container text-xs text-secondary">
            <tr class="border-b border-secondary">
              <th class="text-left font-medium px-4 py-2"><%= t(".columns.month") %></th>
              <th class="text-right font-medium px-3 py-2"><%= t(".columns.income") %></th>
              <th class="text-right font-medium px-3 py-2"><%= t(".columns.spending") %></th>
              <th class="text-right font-medium px-3 py-2"><%= t(".columns.net") %></th>
              <th class="text-right font-medium px-3 py-2"><%= t(".columns.base_net") %></th>
              <th class="text-right font-medium px-3 py-2"><%= t(".columns.net_difference") %></th>
              <th class="text-right font-medium px-3 py-2"><%= t(".columns.total") %></th>
              <th class="text-right font-medium px-4 py-2"><%= t(".columns.total_difference") %></th>
            </tr>
          </thead>
          <tbody>
            <% start_month = start.beginning_of_month %>
            <% comparison.rows.each do |row| %>
              <tr class="border-b border-tertiary <%= "bg-surface" if row.month == start_month %>">
                <td class="px-4 py-1.5 text-primary whitespace-nowrap"><%= l(row.month, format: "%b %Y").capitalize %></td>
                <td class="px-3 py-1.5 text-right whitespace-nowrap"><%= scenario_money(row.income, currency, precision: 0) %></td>
                <td class="px-3 py-1.5 text-right whitespace-nowrap"><%= scenario_money(-row.spending, currency, precision: 0) %></td>
                <td class="px-3 py-1.5 text-right whitespace-nowrap font-medium"><%= scenario_money(row.net, currency, precision: 0) %></td>
                <td class="px-3 py-1.5 text-right whitespace-nowrap text-secondary"><%= scenario_money(row.base_net, currency, precision: 0) %></td>
                <td class="px-3 py-1.5 text-right whitespace-nowrap <%= scenario_difference_class(row.net_difference.round) %>"><%= scenario_signed_money(row.net_difference.round) %></td>
                <td class="px-3 py-1.5 text-right whitespace-nowrap"><%= scenario_money(row.total, currency, precision: 0) %></td>
                <td class="px-4 py-1.5 text-right whitespace-nowrap <%= scenario_difference_class(row.total_difference.round) %>"><%= scenario_signed_money(row.total_difference.round) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>
</div>
