<%# Fulas Bank: the 50/30/20 target and each category's class. %>
<% options = Category::SpendingClass::CLASSES.map { |key| [ t("category_summaries.spending_split.#{key}"), key ] } %>
<%= render DS::Dialog.new do |dialog| %>
  <% dialog.with_header(title: t(".title")) %>
  <% dialog.with_body do %>
    <%= styled_form_with url: spending_split_path, method: :patch, class: "space-y-4", data: { turbo_frame: :_top } do |form| %>
      <div class="space-y-2">
        <p class="text-sm font-medium text-primary"><%= t(".target") %></p>
        <p class="text-xs text-secondary"><%= t(".target_hint") %></p>
        <div class="grid grid-cols-3 gap-2">
          <% %w[essential discretionary savings].each_with_index do |key, index| %>
            <%= form.number_field "target[]", value: @target[index], min: 0, max: 100, step: 1,
                  label: t("category_summaries.spending_split.#{key}"), id: "target_#{key}" %>
          <% end %>
        </div>
      </div>

      <div class="space-y-2">
        <p class="text-sm font-medium text-primary"><%= t(".classes") %></p>
        <p class="text-xs text-secondary"><%= t(".classes_hint") %></p>
        <div class="divide-y divide-divider">
          <% @categories.each do |category| %>
            <div class="py-2 space-y-1">
              <div class="flex items-center justify-between gap-3">
                <span class="flex min-w-0 items-center gap-2 text-sm font-medium text-primary">
                  <%= render DS::FilledIcon.new(variant: :solid, icon: category.lucide_icon, hex_color: category.color, size: "sm", rounded: true) %>
                  <span class="truncate"><%= category.name %></span>
                </span>
                <%= select_tag "classes[#{category.id}]",
                      options_for_select([ [ t(".none"), "" ] ] + options, category.spending_class),
                      class: "form-field__input w-40 text-sm", aria: { label: category.name } %>
              </div>
              <% (@subcategories[category.id] || []).each do |sub| %>
                <div class="flex items-center justify-between gap-3 pl-8">
                  <span class="truncate text-sm text-secondary"><%= sub.name %></span>
                  <%= select_tag "classes[#{sub.id}]",
                        options_for_select([ [ t(".inherit"), "" ] ] + options, sub.spending_class),
                        class: "form-field__input w-40 text-sm", aria: { label: sub.name } %>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>

      <%= form.submit t(".submit") %>
    <% end %>
  <% end %>
<% end %>
