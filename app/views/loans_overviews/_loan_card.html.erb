<%# Fulas Bank: one loan on the Préstamos screen, still being paid or paid off. %>
<%= link_to account_path(row.account), class: "block rounded-xl bg-container shadow-border-xs p-5 space-y-3 hover:bg-container-hover" do %>
  <div class="flex items-start justify-between gap-3">
    <div class="min-w-0">
      <p class="truncate font-display text-base font-semibold text-primary"><%= row.account.name %></p>
      <p class="text-xs text-secondary">
        <%= [ row.account.short_subtype_label.presence,
              (t("loans_overviews.show.rate", rate: number_to_percentage(row.rate, precision: 2)) if row.rate),
              (t("loans_overviews.show.property", name: row.property.name) if row.property) ].compact.join(" · ") %>
      </p>
    </div>
    <div class="text-right shrink-0">
      <p class="font-amount text-lg font-semibold text-primary privacy-sensitive whitespace-nowrap"><%= format_money(row.pending) %></p>
      <p class="text-xs text-secondary"><%= t("loans_overviews.show.pending_short") %></p>
    </div>
  </div>

  <% if row.paid_ratio %>
    <div class="h-2 rounded-full overflow-hidden bg-surface-inset" role="img" aria-label="<%= t("loans_overviews.show.paid_label", percent: number_to_percentage(row.paid_ratio * 100, precision: 0)) %>">
      <div class="h-full rounded-full bg-success" style="width: <%= (row.paid_ratio * 100).round(1) %>%"></div>
    </div>
  <% end %>

  <div class="flex flex-wrap gap-x-4 gap-y-1 text-xs text-secondary">
    <% if row.borrowed %>
      <span class="privacy-sensitive"><%= t("loans_overviews.show.borrowed_on", amount: format_money(row.borrowed, precision: 0)) %></span>
    <% end %>
    <% if row.paid_ratio %>
      <span><%= t("loans_overviews.show.paid_percent", percent: number_to_percentage(row.paid_ratio * 100, precision: 0)) %></span>
    <% end %>
    <% if row.monthly_payment %>
      <span class="privacy-sensitive"><%= t("loans_overviews.show.instalment", amount: format_money(row.monthly_payment)) %></span>
    <% end %>
    <% if row.payoff_date %>
      <span><%= t("loans_overviews.show.ends_on", date: l(row.payoff_date, format: "%B %Y")) %></span>
    <% elsif row.remaining_months %>
      <span><%= t("loans_overviews.show.remaining_months", count: row.remaining_months) %></span>
    <% end %>
  </div>
<% end %>
