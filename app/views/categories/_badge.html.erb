<%# locals: (category:, with_parent: false, size: :md, general: false) %>
<% category ||= Category.uncategorized %>

<%# Canonical category label (Fulas Bank): the category's icon on a square of
    its color, then its name as plain text. With `with_parent:` a
    subcategory also shows its group in small ("Combustible · Transporte").
    `general:` names a main category offered again inside its own group in
    a picker ("Transporte (general)"). "Uncategorized" gets an empty dashed
    square so it stands out. The min-w-0 wrapper lets long names ellipsize
    inside tight columns. %>
<div class="min-w-0 flex">
  <%= render DS::ColorLabel.new(
        label: (general ? t("categories.tree.general", name: category.display_name) : category.display_name),
        color: category.color,
        icon: category.lucide_icon,
        detail: (category.parent&.display_name if with_parent && category.subcategory?),
        dashed: category.uncategorized?,
        size: size,
        label_testid: "category-name") %>
</div>
