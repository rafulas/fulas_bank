<%# locals: (category:) %>
<% category ||= Category.uncategorized %>

<%# The category's square alone, for the narrow mobile row. %>
<div class="flex lg:hidden">
  <%= render DS::ColorLabel.new(
        label: category.display_name,
        color: category.color,
        icon: category.lucide_icon,
        dashed: category.uncategorized?,
        size: :lg,
        show_label: false) %>
</div>
