<%# locals: (group:, option_partial:, option_locals: {}, expanded: false) %>
<%# Fulas Bank: one main category of a category picker. Each choice is
    rendered with the picker's own `option_partial`, given `category:` and
    `general:` (plus `option_locals`); `general` marks the main category
    offered again inside its own group ("Transporte (general)"). A category
    without subcategories is a plain option; one with them is a header that
    opens its subcategories (see category_tree_controller.js). %>
<% if group.subcategories.empty? %>
  <%= render option_partial, **option_locals, category: group.category, general: false %>
<% else %>
  <div data-category-tree-target="group" data-expanded="<%= expanded %>">
    <button type="button"
            class="group/tree flex w-full items-center justify-between gap-2 rounded-lg px-2 py-1.5 text-left hover:bg-container-inset-hover"
            aria-expanded="<%= expanded %>"
            title="<%= t("categories.tree.expand", name: group.category.display_name) %>"
            data-category-tree-target="header"
            data-action="category-tree#toggle">
      <span class="flex min-w-0 items-center gap-1.5">
        <span class="w-5 shrink-0" aria-hidden="true"></span>
        <%= render "categories/badge", category: group.category %>
      </span>
      <span class="flex shrink-0 items-center gap-1 text-xs text-secondary">
        <%= group.subcategories.size %>
        <%= icon("chevron-right", size: "sm", color: "current", class: "transition-transform group-aria-expanded/tree:rotate-90") %>
      </span>
    </button>
    <div class="ml-5 flex flex-col gap-0.5 border-l border-secondary pl-2"
         data-category-tree-target="children"
         <%= "hidden" unless expanded %>>
      <%= render option_partial, **option_locals, category: group.category, general: true %>
      <% group.subcategories.each do |subcategory| %>
        <%= render option_partial, **option_locals, category: subcategory, general: false %>
      <% end %>
    </div>
  </div>
<% end %>
