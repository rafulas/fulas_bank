<%# locals: (item:) %>

<%= styled_form_with model: item, url: (item.persisted? ? forecast_item_path(item) : forecast_items_path), class: "space-y-4", data: { turbo_frame: :_top } do |form| %>
  <% if item.errors.any? %>
    <%= render DS::Alert.new(message: item.errors.full_messages.to_sentence, variant: :error) %>
  <% end %>

  <div class="space-y-3">
    <%= form.text_field :name, label: t(".name"), placeholder: t(".name_placeholder"), required: true %>
    <div class="flex items-center gap-2">
      <%= form.select :nature, [ [ t(".outflow"), "outflow" ], [ t(".inflow"), "inflow" ] ], { label: t(".nature"), container_class: "w-1/3" } %>
      <%= form.money_field :amount, label: t(".amount"), container_class: "w-2/3", disable_currency: true, min: 0 %>
    </div>
    <%= form.date_field :date, label: t(".date"), required: true, min: Date.current + 1 %>
    <%= form.select :account_id, forecast_accounts.map { |account| [ account.name, account.id ] }, { label: t(".account") }, required: true %>
    <%= form.text_area :notes, label: t(".notes"), rows: 2 %>
  </div>

  <%= form.submit t(".submit") %>
<% end %>

<% if item.persisted? %>
  <div class="pt-2">
    <%= render DS::Button.new(
      text: t(".delete"),
      variant: "outline_destructive",
      full_width: true,
      href: forecast_item_path(item),
      method: :delete,
      confirm: CustomConfirm.for_resource_deletion(t(".resource"))
    ) %>
  </div>
<% end %>
