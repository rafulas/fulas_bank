<%# locals: (item:) %>

<%= styled_form_with model: item, url: (item.persisted? ? forecast_item_path(item) : forecast_items_path), class: "space-y-4", data: { turbo_frame: :_top } do |form| %>
  <% if item.errors.any? %>
    <%= render DS::Alert.new(message: item.errors.full_messages.to_sentence, variant: :error) %>
  <% end %>

  <%# Fulas Bank: a transfer leaves «Cuenta» (then «Desde») and reaches «Hacia». %>
  <div class="space-y-3" data-controller="forecast-item-nature"
       data-forecast-item-nature-account-label-value="<%= t(".account") %>"
       data-forecast-item-nature-from-label-value="<%= t(".from_account") %>">
    <%= form.text_field :name, label: t(".name"), placeholder: t(".name_placeholder"), required: true %>
    <div class="flex items-center gap-2">
      <%= form.select :nature, [ [ t(".outflow"), "outflow" ], [ t(".inflow"), "inflow" ], [ t(".transfer"), "transfer" ] ],
                      { label: t(".nature"), container_class: "w-1/3" },
                      data: { forecast_item_nature_target: "nature", action: "forecast-item-nature#refresh" } %>
      <%= form.money_field :amount, label: t(".amount"), container_class: "w-2/3", disable_currency: true, min: 0 %>
    </div>
    <%= form.date_field :date, label: t(".date"), required: true, min: Date.current + 1 %>
    <div data-forecast-item-nature-target="accountLabel">
      <%= form.select :account_id, forecast_accounts.map { |account| [ account.name, account.id ] },
                      { label: item.transfer? ? t(".from_account") : t(".account") }, required: true %>
    </div>
    <div data-forecast-item-nature-target="destination" class="<%= "hidden" unless item.transfer? %>">
      <%= form.select :destination_account_id, forecast_accounts.map { |account| [ account.name, account.id ] },
                      { label: t(".destination_account"), include_blank: t(".destination_blank") },
                      disabled: !item.transfer? %>
    </div>
    <%= form.text_area :notes, label: t(".notes"), rows: 2 %>
  </div>

  <%= form.submit t(".submit") %>
<% end %>

<% if item.persisted? %>
  <div class="pt-2">
    <%= render DS::Button.new(
      text: t(".delete"),
      variant: "outline_destructive",
      full_width: true,
      href: forecast_item_path(item),
      method: :delete,
      confirm: CustomConfirm.for_resource_deletion(t(".resource"))
    ) %>
  </div>
<% end %>
