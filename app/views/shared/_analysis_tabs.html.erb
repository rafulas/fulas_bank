<%# Fulas Bank: Resumen and Informes are one screen with tabs — «Mes» (the
    month by category), «Semana y mes» (the recaps) and «Comparar» (periods
    side by side), «Comercios» (spending by merchant) and «Informe» (a
    snapshot to paste into a spreadsheet). %>
<%= render DS::SegmentedControl.new(aria_label: t("shared.analysis_tabs.aria")) do |control| %>
  <% control.with_segment(t("shared.analysis_tabs.month"), href: category_summaries_path, active: current_page?(category_summaries_path)) %>
  <% control.with_segment(t("shared.analysis_tabs.recaps"), href: recaps_path, active: controller_name == "recaps") %>
  <% control.with_segment(t("shared.analysis_tabs.compare"), href: reports_path, active: current_page?(reports_path)) %>
  <% control.with_segment(t("shared.analysis_tabs.merchants"), href: merchant_activities_path, active: controller_name == "merchant_activities") %>
  <% control.with_segment(t("shared.analysis_tabs.report"), href: status_report_path, active: controller_name == "status_reports") %>
<% end %>
