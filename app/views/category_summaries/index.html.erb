<% content_for :page_header do %>
  <div class="space-y-1 mb-6">
    <h1 class="text-xl lg:text-3xl font-medium text-primary"><%= t(".title") %></h1>
    <p class="text-sm lg:text-base text-secondary"><%= t(".subtitle") %></p>
  </div>
<% end %>

<div class="max-w-2xl space-y-4 pb-6">
  <div class="flex items-center justify-end gap-2">
    <%= render UI::PeriodPicker.new(selected: @period, url: category_summaries_path) %>
  </div>

  <%= render "category_summaries/rings", analysis: @analysis %>

  <%# Fulas Bank: the period's result and savings rate as figure cards. %>
  <div class="grid grid-cols-2 gap-3">
    <%= summary_card title: category_summary_total_label(@period), tone: (@analysis.net.negative? ? :negative : :positive) do %>
      <span class="whitespace-nowrap"><%= format_money(@analysis.net, precision: 0) %></span>
    <% end %>
    <%= summary_card title: t(".savings_rate"), tone: :brand do %>
      <%= format_percent(@analysis.savings_rate) %>
    <% end %>
  </div>

  <%= render "category_summaries/spending_split", split: @spending_split %>

  <p class="px-1 text-xs text-secondary"><%= t(".category") %></p>

  <div class="overflow-hidden rounded-xl bg-container shadow-border-xs">
    <% @summary.rows.each_with_index do |row, index| %>
      <%= render "shared/ruler" unless index.zero? %>
      <%= render "category_summaries/row", row: row, href: category_summary_root_path(row, @period) %>
    <% end %>
  </div>

  <%= render DS::Link.new(
    text: t(".edit_categories"),
    icon: "folder-pen",
    variant: "ghost",
    href: categories_path
  ) %>

  <%= render "category_summaries/analysis", analysis: @analysis, period: @period %>

  <% if @fixed_variable.any? %>
    <%= render "category_summaries/fixed_variable", fixed_variable: @fixed_variable %>
  <% end %>
</div>
