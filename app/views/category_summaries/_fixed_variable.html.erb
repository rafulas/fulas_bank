<%# locals: (fixed_variable:) %>
<%# Fulas Bank: fixed against variable spending, month by month
    (see Category::FixedVariable). %>
<% currency = fixed_variable.currency %>
<% scale = fixed_variable.max_total %>
<% colors = { fixed: "bg-info", recurring: "bg-info/50", variable: "bg-warning" } %>
<section class="space-y-2">
  <div class="flex items-center justify-between px-1 text-xs text-secondary">
    <span><%= t(".title", count: Category::FixedVariable::MONTHS) %></span>
    <span><%= t(".committed", share: fixed_variable.committed_share) %></span>
  </div>
  <div class="rounded-xl bg-container shadow-border-xs p-3 space-y-3">
    <div class="grid gap-1" style="grid-template-columns: repeat(<%= fixed_variable.months.size %>, minmax(0, 1fr))" role="img" aria-label="<%= t(".label") %>">
      <% fixed_variable.months.each do |month| %>
        <div class="flex flex-col items-center text-xs">
          <span class="h-4 text-secondary"><%= "#{month.committed_share} %" if month.total.positive? %></span>
          <div class="flex h-28 w-full items-end justify-center">
            <% if month.total.positive? && scale.positive? %>
              <div class="flex w-4 flex-col-reverse overflow-hidden rounded-t-sm" style="height: <%= (month.total / scale * 100).round(1) %>%"
                   title="<%= t(".tooltip", month: l(month.month, format: "%B %Y"), fixed: format_money(Money.new(month.fixed + month.recurring, currency), precision: 0), variable: format_money(Money.new(month.variable, currency), precision: 0)) %>">
                <% %i[fixed recurring variable].each do |type| %>
                  <% value = month.public_send(type) %>
                  <% if value.positive? %>
                    <div class="<%= colors[type] %>" style="flex: <%= value.to_f %>"></div>
                  <% end %>
                <% end %>
              </div>
            <% end %>
          </div>
          <span class="mt-1 text-secondary first-letter:uppercase"><%= l(month.month, format: "%b") %></span>
        </div>
      <% end %>
    </div>
    <div class="flex flex-wrap gap-x-4 gap-y-1 text-xs text-secondary">
      <% %i[fixed recurring variable].each do |type| %>
        <span class="flex items-center gap-1.5"><span class="h-2.5 w-2.5 rounded-sm <%= colors[type] %>"></span><%= t(".#{type}") %></span>
      <% end %>
    </div>
    <p class="text-xs text-secondary"><%= t(".hint") %></p>
  </div>
</section>
