<%# locals: (summary:) %>
<%# Fulas Bank: where a month starts in the list, its totals, like Bilance's
    "Resumen de mayo". %>
<% month_name = l(summary.month, format: "%B %Y") %>

<div id="month-summary-<%= summary.month.strftime("%Y-%m") %>" class="space-y-2">
  <div class="flex items-center justify-between px-1 pt-2 text-sm font-medium text-primary">
    <h3 class="first-letter:uppercase text-base font-semibold"><%= month_name %></h3>
    <span class="privacy-sensitive font-amount font-bold"><%= forecast_signed_amount(summary.net.amount, summary.net.currency) %></span>
  </div>

  <div class="bg-container rounded-xl shadow-border-xs overflow-hidden">
    <p class="px-4 py-2 text-xs font-semibold uppercase tracking-wider text-secondary bg-surface-inset"><%= t(".title", month: month_name) %></p>
    <div class="grid grid-cols-2 md:grid-cols-4 divide-x divide-primary">
      <div class="px-4 py-2 text-center">
        <p class="font-amount font-bold text-destructive privacy-sensitive"><%= format_money(summary.spent) %></p>
        <p class="text-xs text-secondary"><%= t(".spent") %></p>
      </div>
      <div class="px-4 py-2 text-center">
        <p class="font-amount font-bold text-success privacy-sensitive"><%= format_money(summary.income) %></p>
        <p class="text-xs text-secondary"><%= t(".income") %></p>
      </div>
      <div class="px-4 py-2 text-center">
        <% if (difference = summary.budget_difference) %>
          <p class="font-amount font-bold privacy-sensitive <%= summary.over_budget? ? "text-destructive" : "text-primary" %>"><%= format_money(difference.abs) %></p>
          <p class="text-xs text-secondary"><%= t(summary.over_budget? ? ".over_budget" : ".under_budget") %></p>
        <% else %>
          <p class="text-sm font-medium text-secondary">—</p>
          <p class="text-xs text-secondary"><%= t(".no_budget") %></p>
        <% end %>
      </div>
      <div class="px-4 py-2 text-center">
        <p class="font-amount font-bold text-brand"><%= summary.savings_rate %>%</p>
        <p class="text-xs text-secondary"><%= t(".savings_rate") %></p>
      </div>
    </div>
  </div>
</div>
