<%= render DS::Dialog.new(variant: "drawer", frame: "bulk_transaction_edit_drawer") do |dialog| %>
  <% dialog.with_header(title: t(".header_title"), data: { bulk_select_target: "bulkEditDrawerHeader" }) %>

  <% dialog.with_body do %>
    <%= styled_form_with url: transactions_bulk_update_path, scope: "bulk_update", class: "h-full flex flex-col justify-between gap-4", data: { turbo_frame: "_top" } do |form| %>
      <div class="space-y-4">
        <%= render DS::Disclosure.new(title: t(".overview"), open: true) do %>
          <%= form.date_field :date, label: t(".date_label"), max: Date.current %>
        <% end %>

        <%= render DS::Disclosure.new(title: t(".transactions_section"), open: true) do %>
          <div class="space-y-2">
            <%= form.text_field :name, label: t(".name_label"), placeholder: t(".name_placeholder") %>
            <%= form.collection_select :category_id, Current.family.categories.alphabetically_by_hierarchy, :id, :name, { prompt: t(".category_prompt"), label: t(".category_label"), class: "text-subdued", variant: :badge, searchable: true } %>
            <%= form.collection_select :merchant_id, Current.family.available_merchants_for(Current.user).alphabetically, :id, :name, { prompt: t(".merchant_prompt"), label: t(".merchant_label"), class: "text-subdued" } %>
            <%# Fulas Bank: tags put on or taken off, keeping each movement's others.
                One chip per tag: a tap adds it, another removes it, a third
                leaves it as it is (bulk_tags_controller.js). %>
            <% tags = Current.family.tags.alphabetically.to_a %>
            <% if tags.any? %>
              <div class="space-y-2" data-controller="bulk-tags"
                   data-bulk-tags-add-label-value="<%= t(".tags_add") %>"
                   data-bulk-tags-remove-label-value="<%= t(".tags_remove") %>">
                <div class="flex items-baseline justify-between gap-2">
                  <span class="text-sm text-primary"><%= t(".tags_label") %></span>
                  <span class="text-xs text-secondary" data-bulk-tags-target="summary"></span>
                </div>
                <p class="text-xs text-secondary"><%= t(".tags_hint") %></p>
                <% if tags.size > 12 %>
                  <input type="search" placeholder="<%= t(".tags_search") %>" data-bulk-tags-target="search"
                         data-action="input->bulk-tags#filter" class="form-field__input w-full rounded-lg border border-secondary px-3 py-1.5 text-sm">
                <% end %>
                <div class="flex flex-wrap gap-1.5 max-h-40 overflow-y-auto p-0.5">
                  <% tags.each do |tag| %>
                    <button type="button" data-bulk-tags-target="chip" data-action="bulk-tags#cycle" data-name="<%= tag.name %>"
                            aria-pressed="false"
                            class="inline-flex items-center gap-1 rounded-full border border-secondary px-2.5 py-1 text-sm text-primary cursor-pointer">
                      <span class="w-2 text-center font-semibold" data-mark></span>
                      <span><%= tag.name %></span>
                      <input type="hidden" value="<%= tag.id %>" disabled>
                    </button>
                  <% end %>
                </div>
              </div>
            <% end %>
            <%= form.text_area :notes, label: t(".notes_label"), placeholder: t(".notes_placeholder"), rows: 5 %>
          </div>
        <% end %>

        <%# Fulas Bank: recurring series, fixed/recurring/variable and excluded
            (Transaction::BulkClassification). Blank leaves each one as it is. %>
        <%= render DS::Disclosure.new(title: t(".recurring_section"), open: true) do %>
          <div class="space-y-2">
            <%= form.select :recurring,
                  [ [ t(".recurring_new"), "new" ] ] +
                    Current.family.recurring_transactions.active.includes(:merchant).to_a
                           .sort_by { |series| series.display_name.to_s.downcase }
                           .map { |series| [ t(".recurring_existing", name: series.display_name), series.id ] },
                  { include_blank: t(".no_change"), label: t(".recurring_label") } %>
            <p class="text-xs text-secondary"><%= t(".recurring_hint") %></p>

            <%= form.select :expense_type,
                  Transaction::ExpenseTypeChange::CHOICES.map { |type| [ t("transactions.expense_type.types.#{type}"), type ] },
                  { include_blank: t(".no_change"), label: t(".expense_type_label") } %>
            <%= form.date_field :end_on, label: t(".end_on_label") %>
            <p class="text-xs text-secondary"><%= t(".expense_type_hint") %></p>

            <%= form.select :excluded,
                  [ [ t(".exclude"), "1" ], [ t(".include"), "0" ] ],
                  { include_blank: t(".no_change"), label: t(".excluded_label") } %>

            <%= form.select :one_time,
                  [ [ t(".one_time_on"), "1" ], [ t(".one_time_off"), "0" ] ],
                  { include_blank: t(".no_change"), label: t(".one_time_label") } %>

            <% loans = Current.family.accounts.where(accountable_type: "Loan").alphabetically %>
            <% if loans.any? %>
              <%= form.select :loan_account_id, loans.pluck(:name, :id),
                    { include_blank: t(".no_change"), label: t(".loan_label") } %>
              <p class="text-xs text-secondary"><%= t(".loan_hint") %></p>
            <% end %>
          </div>
        <% end %>
      </div>

      <div class="flex justify-end gap-2 mt-auto">
        <%= render DS::Button.new(text: t(".cancel"), variant: "ghost", data: { action: "click->DS--dialog#close" }) %>
        <%= render DS::Button.new(text: t(".save"), type: :submit, data: { bulk_select_scope_param: "bulk_update", action: "bulk-select#submitBulkRequest" }) %>
      </div>
    <% end %>
  <% end %>
<% end %>
