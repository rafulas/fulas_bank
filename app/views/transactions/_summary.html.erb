<%# locals: (totals:) %>
<%# Show Inflow/Outflow labels only when the result set contains exclusively transfers
    (income and expense are both $0). For mixed filters (e.g. Expense+Transfer),
    we keep Income/Expenses labels — transfer amounts aren't included in the summary
    bar in that case, though the transaction list still shows both types. %>
<% show_transfers = totals.income_money.zero? && totals.expense_money.zero? &&
   (totals.transfer_inflow_money.amount > 0 || totals.transfer_outflow_money.amount > 0) %>
<%# Fulas Bank: three figure cards, as in FlowVista. %>
<div class="grid grid-cols-1 md:grid-cols-3 gap-3">
  <%= summary_card title: t("transactions.summary.total_transactions") do %>
    <span id="total-transactions"><%= totals.count.round(0) %></span>
  <% end %>
  <%= summary_card title: t(show_transfers ? "transactions.summary.inflow" : "transactions.summary.income"), tone: :positive do %>
    <span id="total-income" class="whitespace-nowrap"><%= show_transfers ? (totals.income_money + totals.transfer_inflow_money).format : totals.income_money.format %></span>
  <% end %>
  <%= summary_card title: t(show_transfers ? "transactions.summary.outflow" : "transactions.summary.expenses"), tone: :negative do %>
    <span id="total-expense" class="whitespace-nowrap"><%= show_transfers ? (totals.expense_money + totals.transfer_outflow_money).format : totals.expense_money.format %></span>
  <% end %>
</div>
