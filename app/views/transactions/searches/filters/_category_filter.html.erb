<%# locals: (form:) %>
<%# Fulas Bank: only the main categories, each with its checkbox (which takes
    the whole group) and, when it has subcategories, an arrow that opens
    them to pick only some (category_tree_controller.js). %>
<% categories = Current.family.categories.to_a %>
<div data-controller="list-filter category-filter category-tree">
  <%= render DS::SearchInput.new(
        variant: :embedded,
        placeholder: t(".filter_category"),
        aria_label: t(".filter_category"),
        data: {
          list_filter_target: "input",
          action: "input->list-filter#filter input->category-tree#search"
        }
      ) %>
  <div class="my-2" id="list" data-list-filter-target="list">
    <%= render "transactions/searches/filters/category_option", form: form, category: Category.uncategorized %>

    <% Category::Group.for(categories).each do |group| %>
      <% if group.subcategories.empty? %>
        <%= render "transactions/searches/filters/category_option", form: form, category: group.category %>
      <% else %>
        <% expanded = group.subcategories.any? { |sub| @q[:categories]&.include?(sub.filter_value) } && !@q[:categories]&.include?(group.category.filter_value) %>
        <div data-category-tree-target="group" data-expanded="<%= expanded %>">
          <%= render "transactions/searches/filters/category_option", form: form, category: group.category, expanded: expanded, subcategory_count: group.subcategories.size %>
          <div class="ml-6 border-l border-secondary pl-2" data-category-tree-target="children" <%= "hidden" unless expanded %>>
            <% group.subcategories.each do |subcategory| %>
              <%= render "transactions/searches/filters/category_option", form: form, category: subcategory %>
            <% end %>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
