<%# Fulas Bank: the filter bar, FlowVista style. The search box, then one
    button per question you usually ask the list (when? which account?
    which category?), the rest under "Más filtros", and gastos / ingresos /
    traspasos one click away. Every button shows what it is filtering by;
    each panel applies its own choice and keeps the others. %>
<%= form_with url: transactions_path,
              id: "transactions-search",
              scope: :q,
              method: :get,
              data: { controller: "auto-submit-form" } do |form| %>
  <%= hidden_field_tag :per_page, params[:per_page] %>
  <% Array(@q[:types]).each do |type| %>
    <%= hidden_field_tag "q[types][]", type, id: nil %>
  <% end %>
  <% if @q[:unseen].present? %>
    <%= hidden_field_tag "q[unseen]", "1", id: nil %>
  <% end %>
  <% if @q[:duplicates].present? %>
    <%= hidden_field_tag "q[duplicates]", "1", id: nil %>
  <% end %>

  <div class="flex gap-2 mb-3">
    <div class="grow">
      <div class="flex items-center px-3 py-2 gap-2 border border-secondary rounded-lg focus-within:ring-secondary focus-within:border-secondary">
        <%= icon("search") %>
        <%= form.text_field :search,
                            placeholder: t(".search_placeholder"),
                            value: @q[:search],
                            class: "form-field__input placeholder:text-sm placeholder:text-secondary",
                            "data-auto-submit-form-target": "auto" %>
      </div>
    </div>

    <%# Fulas Bank: on an iPhone or iPad the rows have no checkboxes until
        «Seleccionar» is pressed (checkbox_toggle_controller.js); it then
        reads «Listo». %>
    <%= button_tag type: "button",
        id: "toggle-checkboxes-button",
        aria: { label: t(".toggle_selection_checkboxes"), pressed: "false" },
        class: "lg:hidden font-medium whitespace-nowrap inline-flex items-center gap-1 rounded-lg px-3 py-2 text-sm text-primary border border-secondary hover:bg-surface-hover",
        data: {
          action: "click->checkbox-toggle#toggle",
          checkbox_toggle_target: "toggleButton"
        } do %>
      <%= icon("list-todo") %>
      <span data-checkbox-toggle-target="labelOff"><%= t(".select") %></span>
      <span data-checkbox-toggle-target="labelOn" class="hidden"><%= t(".select_done") %></span>
    <% end %>
  </div>

  <div class="flex flex-wrap items-center gap-2 mb-4">
    <%# When %>
    <% period = active_transaction_period(@q) %>
    <%= render DS::Popover.new(variant: "button", placement: "bottom-start", no_padding: true) do |popover| %>
      <% popover.with_button(id: "transaction-period-button", type: "button", text: transaction_period_label(@q),
                             variant: (period == "all" ? "outline" : "secondary"), icon: "calendar", size: :sm) %>
      <% popover.with_custom_content do %>
        <%# Fulas Bank: the period picker, after Bilance. %>
        <%= render "shared/period_picker", id: "transaction-period-menu",
              start_name: "q[start_date]", end_name: "q[end_date]",
              start: @q[:start_date], finish: @q[:end_date] %>
      <% end %>
    <% end %>

    <%# Which account %>
    <%= render DS::Popover.new(variant: "button", placement: "bottom-start", no_padding: true) do |popover| %>
      <% popover.with_button(id: "transaction-account-button", type: "button",
                             text: transaction_filter_label(t("transactions.search.filters.account"), @q[:accounts]),
                             variant: (@q[:accounts].present? ? "secondary" : "outline"), icon: "layers", size: :sm) %>
      <% popover.with_custom_content do %>
        <div id="transaction-account-menu" class="w-80">
          <div class="max-h-80 overflow-y-auto p-3">
            <%= render "transactions/searches/filters/account_filter", form: form %>
          </div>
          <%= render "transactions/searches/apply", key: :accounts %>
        </div>
      <% end %>
    <% end %>

    <%# Which category %>
    <%= render DS::Popover.new(variant: "button", placement: "bottom-start", no_padding: true) do |popover| %>
      <% popover.with_button(id: "transaction-category-button", type: "button",
                             text: transaction_filter_label(t("transactions.search.filters.category"), @q[:categories]),
                             variant: (@q[:categories].present? ? "secondary" : "outline"), icon: "shapes", size: :sm) %>
      <% popover.with_custom_content do %>
        <div id="transaction-category-menu" class="w-80">
          <div class="max-h-80 overflow-y-auto p-3">
            <%= render "transactions/searches/filters/category_filter", form: form %>
          </div>
          <%= render "transactions/searches/apply", key: :categories %>
        </div>
      <% end %>
    <% end %>

    <%# Fulas Bank: only the new movements (blue dot), on and off. %>
    <% unseen_on = @q[:unseen].present? %>
    <%= render DS::Link.new(
          id: "transaction-unseen-button",
          text: t(".unseen", count: @unseen_count.to_i),
          icon: "eye",
          variant: (unseen_on ? "secondary" : "outline"),
          size: :sm,
          href: transactions_filter_path(@q, unseen: (unseen_on ? nil : "1")),
          aria: { pressed: unseen_on }
        ) %>

    <%# Fulas Bank: the movements without a category, on and off. %>
    <% uncategorized_on = Array(@q[:categories]) == [ Category::UNCATEGORIZED_FILTER_VALUE ] %>
    <%= render DS::Link.new(
          id: "transaction-uncategorized-button",
          text: t(".uncategorized", count: @uncategorized_count.to_i),
          icon: "tag",
          variant: (uncategorized_on ? "secondary" : "outline"),
          size: :sm,
          href: transactions_filter_path(@q, categories: (uncategorized_on ? nil : [ Category::UNCATEGORIZED_FILTER_VALUE ])),
          aria: { pressed: uncategorized_on }
        ) %>

    <%# Fulas Bank: the movements that may be there twice, on and off. %>
    <% duplicates_on = @q[:duplicates].present? %>
    <%= render DS::Link.new(
          id: "transaction-duplicates-button",
          text: t(".duplicates"),
          icon: "copy",
          variant: (duplicates_on ? "secondary" : "outline"),
          size: :sm,
          href: transactions_filter_path(@q, duplicates: (duplicates_on ? nil : "1")),
          aria: { pressed: duplicates_on }
        ) %>

    <%# Everything else %>
    <% more = %i[status amount tags merchants ai_status].count { |key| @q[key].present? } %>
    <%= render DS::Popover.new(variant: "button", placement: "bottom-start", no_padding: true) do |popover| %>
      <% popover.with_button(id: "transaction-filters-button", type: "button",
                             text: transaction_filter_label(t(".more_filters"), Array.new(more)),
                             variant: (more.positive? ? "secondary" : "outline"), icon: "list-filter", size: :sm) %>
      <% popover.with_custom_content do %>
        <%= render "transactions/searches/menu", form: form %>
      <% end %>
    <% end %>

    <%# Gastos, ingresos, traspasos %>
    <% type = Array(@q[:types]).one? ? Array(@q[:types]).first : nil %>
    <%= render DS::SegmentedControl.new(aria_label: t("transactions.search.filters.type")) do |control| %>
      <% control.with_segment(t("transactions.searches.bar.types.all"), href: transactions_filter_path(@q, types: nil), active: type.nil?) %>
      <% TransactionsHelper::TRANSACTION_TYPES.each do |each_type| %>
        <% control.with_segment(t("transactions.searches.bar.types.#{each_type}"), href: transactions_filter_path(@q, types: [ each_type ]), active: type == each_type) %>
      <% end %>
    <% end %>

    <% if @q.present? %>
      <%= render DS::Link.new(text: t(".clear_filters"), icon: "x", variant: "ghost", size: :sm, href: transactions_path(clear_filters: true)) %>
    <% end %>
  </div>
<% end %>
