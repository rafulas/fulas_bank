<%# locals: (panel:) %>
<%# Fulas Bank: chosen accounts' balances and this week's spending day by
    day; the two weeks before and the balance of those accounts over 90
    days are folded under «Análisis». %>

<section id="transactions-panel" class="space-y-3">
  <div class="flex items-center justify-between gap-2">
    <h2 class="text-sm font-medium text-secondary"><%= t(".accounts_title") %></h2>
    <%= render DS::Link.new(text: t(".choose_accounts"), icon: "settings-2", variant: :ghost, size: :sm, href: edit_transactions_panel_accounts_path, frame: :modal) %>
  </div>

  <% if panel.accounts.any? %>
    <div class="grid grid-cols-2 md:grid-cols-3 gap-2">
      <% panel.accounts.each do |account| %>
        <%= link_to account_path(account), class: "flex items-center gap-3 bg-container rounded-xl shadow-border-xs px-3 py-2 min-w-0 hover:bg-container-hover" do %>
          <%= render DS::FilledIcon.new(icon: "wallet", size: "md", rounded: true) %>
          <div class="min-w-0">
            <p class="text-xs text-secondary truncate"><%= account.name %></p>
            <p class="text-sm font-medium text-primary privacy-sensitive"><%= format_money(account.balance_money) %></p>
          </div>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <%# Fulas Bank: only this week stays in view, so the list starts higher;
      the weeks before and the 90-day balance fold into «Análisis». %>
  <% last_index = panel.weeks.size - 1 %>
  <% if (this_week = panel.weeks.last) %>
    <%= render "transactions/panel_week", panel: panel, week: this_week, index: last_index %>
  <% end %>

  <%= render DS::Disclosure.new(title: t(".analysis"), align: "left") do %>
    <div class="space-y-2">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-2">
        <% panel.weeks.first(last_index).each_with_index do |week, index| %>
          <%= render "transactions/panel_week", panel: panel, week: week, index: index %>
        <% end %>
      </div>
    <% if (series = panel.balance_series) %>
      <div class="bg-container rounded-xl shadow-border-xs p-3 space-y-2">
        <p class="text-xs text-secondary"><%= t(".balance_title", days: Transaction::Panel::BALANCE_DAYS) %></p>
        <div class="h-32 w-full" data-controller="time-series-chart" data-time-series-chart-data-value="<%= series.to_json %>"></div>
      </div>
    <% end %>
    </div>
  <% end %>
</section>
