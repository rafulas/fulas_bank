<%= render DS::Dialog.new do |dialog| %>
  <% dialog.with_header(title: @panel.home? ? t(".home_title") : t(".title")) %>
  <% dialog.with_body do %>
    <%= form_with url: transactions_panel_accounts_path(scope: (@panel.home? ? "home" : nil)), method: :patch, class: "space-y-4", data: { turbo_frame: :_top } do |form| %>
      <p class="text-sm text-secondary"><%= @panel.home? ? t(".home_hint") : t(".hint") %></p>
      <%= hidden_field_tag "account_ids[]", "" %>
      <ul class="space-y-2">
        <% @panel.selectable_accounts.each do |account| %>
          <li>
            <label class="flex items-center justify-between gap-3 text-sm text-primary">
              <span class="flex items-center gap-2">
                <%= check_box_tag "account_ids[]", account.id, @panel.accounts.include?(account), id: dom_id(account, :panel), class: "checkbox checkbox--light" %>
                <%= account.name %>
              </span>
              <span class="text-secondary privacy-sensitive"><%= format_money(account.balance_money) %></span>
            </label>
          </li>
        <% end %>
      </ul>
      <% if @panel.home? && @panel.selectable_cards.any? %>
        <%# Fulas Bank: the cards whose next statements Inicio lists. %>
        <div class="space-y-2 border-t border-secondary pt-4">
          <p class="text-sm font-medium text-primary"><%= t(".cards") %></p>
          <p class="text-xs text-secondary"><%= t(".cards_hint") %></p>
          <%= hidden_field_tag "card_ids[]", "", id: nil %>
          <ul class="space-y-2">
            <% @panel.selectable_cards.each do |card| %>
              <li>
                <label class="flex items-center gap-2 text-sm text-primary">
                  <%= check_box_tag "card_ids[]", card.id, @panel.statement_cards.include?(card), id: dom_id(card, :statement_card), class: "checkbox checkbox--light" %>
                  <%= card.name %>
                </label>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>
      <%= render DS::Button.new(text: t(".submit"), full_width: true, type: "submit") %>
    <% end %>
  <% end %>
<% end %>
