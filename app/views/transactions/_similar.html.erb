<%# locals: (similar:) %>
<%# Fulas Bank: movements from the same merchant or with the same name, newest
    first. The 🔁 marks the ones that are payments of a recurring series. %>
<%# Fulas Bank: the three newest in sight, the rest under «Ver los N». %>
<% shown = similar.entries.first(3) %>
<% more = similar.entries.drop(3) %>
<ul class="divide-y divide-primary" id="transaction_similar">
  <% shown.each do |entry| %>
    <%= render "transactions/similar_item", entry: entry %>
  <% end %>
</ul>
<% if more.any? %>
  <%= render DS::Disclosure.new(title: t(".show_all", count: similar.entries.size)) do %>
    <ul class="divide-y divide-primary">
      <% more.each do |entry| %>
        <%= render "transactions/similar_item", entry: entry %>
      <% end %>
    </ul>
  <% end %>
<% end %>
