<%# locals: (panel:, week:, index:) %>
<%# Fulas Bank: one week of spending, day by day, in the Transactions panel. %>
<div class="bg-container rounded-xl shadow-border-xs p-3 space-y-2">
  <div class="flex items-center justify-between gap-2 text-xs">
    <span class="text-secondary"><%= transactions_panel_week_label(week, index, panel.weeks.size) %></span>
    <span class="text-primary font-medium privacy-sensitive"><%= forecast_signed_amount(-week.total, panel.currency) %></span>
  </div>
  <div class="grid grid-cols-7 gap-1 items-end h-28" role="img" aria-label="<%= t("transactions.panel.week_chart_label", week: transactions_panel_week_label(week, index, panel.weeks.size)) %>">
    <% week.days.each do |day| %>
      <div class="flex flex-col items-center justify-end h-full gap-1 min-w-0">
        <% if day.total.positive? %>
          <span class="text-xs text-secondary privacy-sensitive whitespace-nowrap"><%= transactions_panel_compact_amount(day.total, panel.currency) %></span>
          <div class="w-3 flex flex-col-reverse rounded-sm overflow-hidden" style="height: <%= transactions_panel_bar_height(day.total, panel.max_day_total) %>%" title="<%= transactions_panel_day_title(day, panel.currency) %>">
            <% day.segments.each do |segment| %>
              <div style="height: <%= (segment.amount / day.total * 100).round(2) %>%; background-color: <%= segment.color %>"></div>
            <% end %>
          </div>
        <% end %>
        <span class="text-xs <%= day.date == Date.current ? "text-primary font-medium" : "text-secondary" %>"><%= l(day.date, format: "%a") %></span>
      </div>
    <% end %>
  </div>
</div>
