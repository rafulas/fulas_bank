<%# locals: (entry:, can_edit:) %>
<% transaction = entry.transaction %>
<% series = transaction.recurring_series %>
<% current = Transaction::ExpenseTypeChange.current_choice(transaction) %>
<% ends_on = series&.ends_on_date? ? series.end_on : nil %>

<div class="px-3 py-2 space-y-3" id="<%= dom_id(entry, :expense_type) %>">
  <p class="text-sm text-secondary">
    <%= t(".current", type: t(".types.#{current}")) %>
    <% unless transaction.expense_type_chosen? %>
      <%= t(series ? ".automatic_series" : ".automatic_default") %>
    <% end %>
  </p>

  <% if series %>
    <p class="text-xs text-secondary">
      <%= t(".series", name: series.display_name) %>
      <% if ends_on %>
        · <%= t(".ends_on", date: format_date(ends_on)) %>
      <% end %>
    </p>
  <% end %>

  <% if can_edit %>
    <%= styled_form_with scope: :expense_type, url: transaction_expense_type_path(entry), method: :patch,
          class: "space-y-3", data: { controller: "expense-type-form", turbo_frame: :_top } do |form| %>
      <%= form.select :expense_type,
            Transaction::ExpenseTypeChange::CHOICES.map { |type| [ t(".types.#{type}"), type ] },
            { label: t(".type_label"), selected: current },
            { data: { expense_type_form_target: "type", action: "change->expense-type-form#refresh" } } %>

      <div class="space-y-3" data-expense-type-form-target="end">
        <%= form.select :ends_by,
              [ [ t(".ends_by_never"), "never" ], [ t(".ends_by_date"), "date" ], [ t(".ends_by_periods"), "periods" ] ],
              { label: t(".ends_by_label"), selected: ends_on ? "date" : "never" },
              { data: { expense_type_form_target: "endsBy", action: "change->expense-type-form#refresh" } } %>
        <div data-expense-type-form-target="date">
          <%= form.date_field :end_on, label: t(".end_on_label"), value: ends_on %>
        </div>
        <div data-expense-type-form-target="periods">
          <%= form.number_field :periods, label: t(".periods_label"), min: 1, max: Transaction::ExpenseTypeChange::MAX_PERIODS, step: 1 %>
        </div>
      </div>

      <p class="text-xs text-secondary"><%= t(".hint") %></p>
      <%= form.submit t(".submit") %>
    <% end %>
  <% end %>
</div>
