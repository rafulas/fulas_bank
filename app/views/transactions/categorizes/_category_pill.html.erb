<%# locals: (category:, general: false) %>
<% label = general ? t("categories.tree.general", name: category.display_name) : category.display_name %>
<button type="submit"
        name="category_id"
        value="<%= category.id %>"
        class="filterable-item inline-flex items-center rounded-full border border-secondary bg-container px-2.5 py-1 cursor-pointer hover:bg-container-inset-hover focus:outline-none focus:ring-2 focus:ring-offset-1"
        data-filter-name="<%= category.parent_id.present? ? category.display_name_with_parent : label %>">
  <%= render DS::ColorLabel.new(label: label, color: category.color, icon: category.lucide_icon, size: :sm, truncate: false) %>
</button>
