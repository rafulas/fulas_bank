<%= content_for :page_title, t(".title") %>
<%= content_for :page_actions do %>
  <%= render DS::Link.new(text: t(".back"), variant: "secondary", href: rules_path, icon: "arrow-left") %>
  <% if @suggestions.size > 1 %>
    <%= render DS::Button.new(text: t(".create_all", count: @suggestions.size), href: rule_suggestions_path(all: "1"), icon: "wand-sparkles",
          confirm: CustomConfirm.new(title: t(".create_all_confirm.title"), body: t(".create_all_confirm.body", count: @suggestions.size), btn_text: t(".create_all", count: @suggestions.size))) %>
  <% end %>
<% end %>

<div class="bg-container rounded-xl shadow-border-xs p-4 space-y-4">
  <p class="text-sm text-secondary"><%= t(".description") %></p>

  <% if @suggestions.empty? %>
    <div class="flex justify-center items-center py-12">
      <div class="text-center max-w-md space-y-1">
        <p class="text-sm text-primary font-medium"><%= t(".empty_title") %></p>
        <p class="text-sm text-secondary"><%= t(".empty_description") %></p>
      </div>
    </div>
  <% else %>
    <%= render DS::Table.new(rows: @suggestions, label: t(".title")) do |table| %>
      <% table.with_column(t(".name_contains")) do |suggestion| %>
        <span class="font-medium text-primary"><%= suggestion.key %></span>
        <span class="block text-xs text-secondary truncate max-w-64" title="<%= suggestion.examples.join(" · ") %>"><%= suggestion.examples.join(" · ") %></span>
      <% end %>
      <% table.with_column(t(".category")) do |suggestion| %>
        <span class="inline-flex items-center gap-1.5 text-primary">
          <%= render DS::FilledIcon.new(icon: suggestion.category.lucide_icon, hex_color: suggestion.category.color, size: "sm") %>
          <%= suggestion.category.name %>
        </span>
        <span class="block text-xs text-secondary"><%= t(".types.#{suggestion.transaction_type}") %></span>
      <% end %>
      <% table.with_column(t(".history"), numeric: true) do |suggestion| %>
        <%= t(".history_count", count: suggestion.count, share: number_to_percentage(suggestion.share * 100, precision: 0)) %>
      <% end %>
      <% table.with_column(t(".uncategorized"), numeric: true) { |suggestion| suggestion.uncategorized_count } %>
      <% table.with_column("", align: :right) do |suggestion| %>
        <div class="flex items-center justify-end gap-1">
          <%= render DS::Button.new(text: t(".create"), size: :sm, href: rule_suggestions_path(id: suggestion.id)) %>
          <%= render DS::Button.new(icon: "x", variant: :icon, size: :sm, href: dismiss_rule_suggestions_path(id: suggestion.id), aria: { label: t(".dismiss", name: suggestion.key) }) %>
        </div>
      <% end %>
    <% end %>
  <% end %>
</div>
