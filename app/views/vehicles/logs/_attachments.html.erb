<%# locals: (account:, log:) %>

<% stored = log.attachments.select(&:persisted?) %>
<% if stored.any? %>
  <div class="pt-4 space-y-2">
    <h4 class="text-sm font-medium text-primary"><%= t(".title", count: stored.size) %></h4>
    <ul class="space-y-2">
      <% stored.each do |attachment| %>
        <li class="flex items-center justify-between gap-3 p-3 border border-primary rounded-lg bg-container">
          <div class="flex items-center gap-3 min-w-0">
            <%= icon(attachment.image? ? "image" : "file-text", size: "sm") %>
            <div class="min-w-0">
              <p class="text-sm font-medium text-primary truncate"><%= attachment.filename %></p>
              <p class="text-xs text-secondary"><%= number_to_human_size(attachment.byte_size) %></p>
            </div>
          </div>

          <div class="flex items-center gap-2 shrink-0">
            <%= render DS::Link.new(
              href: vehicle_log_attachment_path(account, log, attachment, disposition: :inline),
              variant: :outline,
              size: :sm,
              icon: "eye",
              text: "",
              aria: { label: t(".open", filename: attachment.filename) },
              target: "_blank"
            ) %>
            <%= render DS::Link.new(
              href: vehicle_log_attachment_path(account, log, attachment, disposition: :attachment),
              variant: :outline,
              size: :sm,
              icon: "download",
              text: "",
              aria: { label: t(".download", filename: attachment.filename) },
              data: { turbo: false }
            ) %>
            <%= render DS::Button.new(
              href: vehicle_log_attachment_path(account, log, attachment),
              method: :delete,
              variant: :outline_destructive,
              size: :sm,
              icon: "trash-2",
              aria_label: t(".delete", filename: attachment.filename),
              confirm: CustomConfirm.for_resource_deletion(t(".resource"))
            ) %>
          </div>
        </li>
      <% end %>
    </ul>
  </div>
<% end %>
