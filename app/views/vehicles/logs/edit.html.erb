<%= render DS::Dialog.new do |dialog| %>
  <% dialog.with_header(title: t(".title.#{@log.kind}")) %>
  <% dialog.with_body do %>
    <% if @linking_entry %>
      <%= render DS::Alert.new(message: t(".linking", name: @linking_entry.name, date: format_date(@log.date)), variant: :info) %>
    <% elsif @log.suggested? %>
      <%= render DS::Alert.new(message: t(@log.fuel? ? ".suggested_fuel" : ".suggested"), variant: :info) %>
    <% end %>
    <%= render "form", account: @account, log: @log %>
  <% end %>
<% end %>
