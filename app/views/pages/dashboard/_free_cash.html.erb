<%# locals: (free_cash:) %>
<%# Fulas Bank: FlowVista's headline card — what is left of the period's
    income after its expenses, with the two totals, how much is spent, the
    days left, the daily spending and the saving rate against 20 %. %>
<% free = free_cash.free %>
<% ratio = free_cash.ratio %>

<section class="mb-6 rounded-xl bg-container shadow-border-xs border-t-4 border-t-brand px-6 py-5 space-y-4" aria-labelledby="free-cash-title">
  <div class="flex flex-wrap items-start justify-between gap-6">
    <div class="space-y-1.5">
      <h2 id="free-cash-title" class="font-sans text-xs font-semibold uppercase tracking-wider text-secondary"><%= t("pages.dashboard.free_cash.title") %> · <%= free_cash.period.label %></h2>
      <p class="<%= class_names("font-amount text-4xl lg:text-5xl font-semibold leading-none privacy-sensitive", "text-primary") %>"><%= format_money(free) %></p>
      <p class="text-sm text-secondary privacy-sensitive"><%= t("pages.dashboard.free_cash.of_income", amount: format_money(free_cash.income)) %></p>
    </div>

    <dl class="min-w-64 space-y-2">
      <div class="flex items-center justify-between gap-6 pb-2 border-b border-divider">
        <dt class="flex items-center gap-2 text-sm font-medium text-primary"><span class="w-2 h-2 rounded-sm bg-success" aria-hidden="true"></span><%= t("pages.dashboard.free_cash.income") %></dt>
        <dd class="font-amount text-lg font-semibold text-primary privacy-sensitive whitespace-nowrap"><%= format_money(free_cash.income) %></dd>
      </div>
      <div class="flex items-center justify-between gap-6">
        <dt class="flex items-center gap-2 text-sm font-medium text-primary"><span class="w-2 h-2 rounded-sm bg-destructive" aria-hidden="true"></span><%= t("pages.dashboard.free_cash.expense") %></dt>
        <dd class="font-amount text-lg font-semibold text-primary privacy-sensitive whitespace-nowrap"><%= format_money(free_cash.expense) %></dd>
      </div>
    </dl>
  </div>

  <% if ratio %>
    <% percent = number_to_percentage(ratio * 100, precision: 1) %>
    <div class="h-2 rounded-full bg-surface-inset overflow-hidden" role="img" aria-label="<%= t("pages.dashboard.free_cash.spent", percent: percent) %>">
      <div class="<%= class_names("h-full rounded-full", ratio > 1 ? "bg-destructive" : "bg-success") %>" style="width: <%= [ ratio * 100, 100 ].min.round(1) %>%"></div>
    </div>
    <div class="flex flex-wrap justify-between gap-2 text-sm text-secondary">
      <span><%= t("pages.dashboard.free_cash.spent", percent: percent) %></span>
      <% if ratio < 1 %>
        <span class="<%= class_names("font-medium", free_cash.meets_target? ? "text-success" : "text-warning") %>">
          <%= t("pages.dashboard.free_cash.saving_vs_target", percent: number_to_percentage(free_cash.saving_rate, precision: 1), target: number_to_percentage(FreeCash::SAVING_TARGET, precision: 0)) %>
        </span>
      <% end %>
    </div>
  <% else %>
    <p class="text-sm text-secondary"><%= t("pages.dashboard.free_cash.no_income") %></p>
  <% end %>

  <dl class="grid grid-cols-2 lg:grid-cols-4 gap-x-6 gap-y-3 pt-4 border-t border-divider">
    <div class="space-y-0.5">
      <dt class="text-xs text-secondary"><%= t("pages.dashboard.free_cash.days_left_label") %></dt>
      <dd class="font-amount text-base font-semibold text-primary whitespace-nowrap">
        <%= free_cash.days_left ? t("pages.dashboard.free_cash.days", count: free_cash.days_left) : t("pages.dashboard.free_cash.period_over") %>
      </dd>
    </div>
    <div class="space-y-0.5">
      <dt class="text-xs text-secondary"><%= t("pages.dashboard.free_cash.daily_average_label") %></dt>
      <dd class="font-amount text-base font-semibold text-primary privacy-sensitive whitespace-nowrap">
        <%= free_cash.daily_average ? t("pages.dashboard.free_cash.per_day", amount: format_money(free_cash.daily_average)) : "—" %>
      </dd>
    </div>
    <div class="space-y-0.5">
      <dt class="text-xs text-secondary"><%= t("pages.dashboard.free_cash.per_day_left_label") %></dt>
      <dd class="font-amount text-base font-semibold text-brand privacy-sensitive whitespace-nowrap">
        <%= free_cash.per_day_left ? t("pages.dashboard.free_cash.per_day", amount: format_money(free_cash.per_day_left)) : "—" %>
      </dd>
    </div>
    <div class="space-y-0.5">
      <dt class="text-xs text-secondary"><%= t("pages.dashboard.free_cash.change_label") %></dt>
      <% change = free_cash.expense_change %>
      <dd class="<%= class_names("font-amount text-base font-semibold whitespace-nowrap", change.nil? ? "text-secondary" : (change.positive? ? "text-destructive" : "text-success")) %>">
        <% if change.nil? %>
          —
        <% elsif change.zero? %>
          <%= t("pages.dashboard.free_cash.no_change") %>
        <% else %>
          <%= change.positive? ? "↑" : "↓" %> <%= number_to_percentage(change.abs, precision: 0) %>
        <% end %>
      </dd>
    </div>
  </dl>
</section>
