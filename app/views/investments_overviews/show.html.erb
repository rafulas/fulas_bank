<% overview = @overview %>

<% content_for :page_header do %>
  <div class="flex flex-wrap items-start justify-between gap-3 mb-6">
    <div class="space-y-1">
      <h1 class="text-xl lg:text-3xl font-medium text-primary"><%= t(".title") %></h1>
      <p class="text-sm lg:text-base text-secondary"><%= t(".subtitle") %></p>
    </div>
    <%# Fulas Bank: one button for the prices of every share, instead of the
        "Actualizar" inside each position. %>
    <% if overview.rows.any? %>
      <%= render DS::Button.new(
        text: t(".refresh_prices"),
        icon: "refresh-cw",
        variant: :outline,
        size: :sm,
        href: refresh_prices_investments_overview_path,
        method: :post,
        data: { turbo_submits_with: t(".refreshing_prices") }
      ) %>
    <% end %>
  </div>
<% end %>

<div class="max-w-3xl space-y-4 pb-6">
  <% if overview.rows.empty? %>
    <%= render DS::EmptyState.new(icon: "line-chart", title: t(".empty_title"), description: t(".empty_description")) %>
  <% else %>
    <div class="@container">
      <div class="grid grid-cols-2 @2xl:grid-cols-5 gap-2">
        <%= summary_card title: t(".value"), tone: :brand do %>
          <span class="whitespace-nowrap"><%= format_money(overview.total_value, precision: 0) %></span>
        <% end %>
        <%= summary_card title: t(".contributed") do %>
          <span class="whitespace-nowrap"><%= format_money(overview.total_contributed, precision: 0) %></span>
        <% end %>
        <%= summary_card title: t(".gain"), tone: (overview.total_gain.negative? ? :negative : :positive) do %>
          <span class="whitespace-nowrap <%= overview.total_gain.negative? ? "text-destructive" : "text-success" %>"><%= format_money(overview.total_gain, precision: 0) %></span>
        <% end %>
        <%= summary_card title: t(".return") do %>
          <%= overview.total_return_ratio ? number_to_percentage(overview.total_return_ratio * 100, precision: 2) : "—" %>
        <% end %>
        <%# Fulas Bank: the yearly return, weighting when each euro went in. %>
        <%= summary_card title: t(".annual_return") do %>
          <% annual = overview.annual_return.rate %>
          <% if annual %>
            <span class="<%= annual.negative? ? "text-destructive" : "text-success" %>"><%= number_to_percentage(annual * 100, precision: 2) %></span>
          <% elsif overview.annual_return.young? %>
            <span class="text-sm font-normal text-secondary"><%= t(".under_a_year") %></span>
          <% else %>
            —
          <% end %>
        <% end %>
      </div>
      <p class="mt-2 text-xs text-secondary"><%= t(".annual_return_hint") %></p>
      <%# Fulas Bank: say which accounts the contributions and gain cover. %>
      <% if (missing = overview.rows_without_contributions).any? && overview.total_contributed.amount.positive? %>
        <p class="mt-1 text-xs text-secondary"><%= t(".partial_totals", accounts: missing.map { |row| row.account.name }.to_sentence) %></p>
      <% end %>
    </div>

    <%= render "investments_overviews/realized_gains", realized: @realized %>

    <% if overview.suggested_trades.any? %>
      <%= render "investments_overviews/suggested_trades", trades: overview.suggested_trades %>
    <% end %>

    <% if overview.by_kind.size > 1 %>
      <% total = overview.total_value.amount %>
      <div class="rounded-xl bg-container shadow-border-xs p-4 space-y-2">
        <p class="text-xs text-secondary"><%= t(".by_kind") %></p>
        <% overview.by_kind.each do |label, money| %>
          <div class="space-y-1">
            <div class="flex justify-between gap-3 text-sm">
              <span class="truncate text-primary"><%= label %></span>
              <span class="shrink-0 text-primary privacy-sensitive whitespace-nowrap font-amount font-semibold"><%= format_money(money, precision: 0) %></span>
            </div>
            <% if total.positive? %>
              <div class="h-1.5 rounded-full overflow-hidden bg-surface-inset">
                <div class="h-full rounded-full bg-info" style="width: <%= (money.amount / total * 100).round(1) %>%"></div>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>

    <%= render DS::Table.new(rows: overview.rows, dense: true, label: t(".title")) do |table| %>
      <% table.with_column(t(".account")) do |row| %>
        <%= link_to row.account.name, account_path(row.account), class: "text-primary hover:underline" %>
        <span class="block text-secondary"><%= row.account.short_subtype_label %></span>
      <% end %>
      <% table.with_column(t(".contributed"), numeric: true, class: "privacy-sensitive") { |row| row.contributed ? format_money(row.contributed) : "—" } %>
      <% table.with_column(t(".value"), numeric: true, class: "privacy-sensitive font-medium bg-info/10") { |row| format_money(row.value) } %>
      <% table.with_column(t(".gain"), numeric: true, class: "privacy-sensitive") do |row| %>
        <% if row.gain %>
          <span class="<%= row.gain.negative? ? "text-destructive" : "text-success" %>"><%= format_money(row.gain) %></span>
        <% else %>
          —
        <% end %>
      <% end %>
      <% table.with_column(t(".return"), numeric: true) do |row| %>
        <% if row.return_ratio %>
          <span class="<%= row.return_ratio.negative? ? "text-destructive" : "text-success" %>"><%= number_to_percentage(row.return_ratio * 100, precision: 2) %></span>
        <% else %>
          —
        <% end %>
      <% end %>
      <% table.with_column(t(".annual_return"), numeric: true) do |row| %>
        <% if (annual = overview.annual_return.rate_for(row.account)) %>
          <span class="<%= annual.negative? ? "text-destructive" : "text-success" %>"><%= number_to_percentage(annual * 100, precision: 2) %></span>
        <% elsif overview.annual_return.young?(row.account) %>
          <span class="text-secondary"><%= t(".under_a_year") %></span>
        <% else %>
          —
        <% end %>
      <% end %>
    <% end %>

    <%# Funds held by participaciones: units × valor liquidativo %>
    <% if overview.rows.any? { |row| row.account.accountable_type == "Investment" } %>
      <%= render DS::Card.new(class: "gap-3") do %>
        <div class="flex flex-wrap items-start justify-between gap-2">
          <div class="space-y-1">
            <h3 class="text-sm font-medium text-primary"><%= t(".funds_title") %></h3>
            <p class="text-xs text-secondary"><%= t(".funds_hint") %></p>
          </div>
          <div class="flex items-center gap-2">
            <% if overview.funds.any? %>
              <%= render DS::Link.new(text: t(".update_prices"), icon: "refresh-cw", variant: (overview.any_stale_fund? ? :primary : :outline), size: :sm,
                    href: edit_investment_fund_prices_path, frame: :modal) %>
            <% end %>
            <%= render DS::Link.new(text: t(".add_fund"), icon: "plus", variant: :outline, size: :sm, href: new_investment_fund_path, frame: :modal) %>
          </div>
        </div>

        <% if overview.funds.any? %>
          <%= render DS::Table.new(rows: overview.funds, dense: true, label: t(".funds_title")) do |table| %>
            <% table.with_column(t(".fund")) do |fund| %>
              <span class="text-primary"><%= fund.name %></span>
              <span class="block text-secondary"><%= [ fund.isin, fund.account.name ].compact.join(" · ") %></span>
            <% end %>
            <% table.with_column(t(".units"), numeric: true, class: "privacy-sensitive") { |fund| number_with_precision(fund.units, precision: 4, strip_insignificant_zeros: true) } %>
            <% table.with_column(t(".price"), numeric: true) do |fund| %>
              <% if fund.price %>
                <span class="privacy-sensitive"><%= number_with_precision(fund.price, precision: 4) %></span>
                <span class="block <%= fund.stale? ? "text-warning" : "text-secondary" %>"><%= l(fund.price_date, format: "%d/%m/%y") %></span>
              <% else %>
                —
              <% end %>
            <% end %>
            <% table.with_column(t(".value"), numeric: true, class: "privacy-sensitive font-medium bg-info/10") { |fund| format_money(fund.value) } %>
            <% table.with_column(t(".gain"), numeric: true, class: "privacy-sensitive") do |fund| %>
              <% if fund.gain %>
                <span class="<%= fund.gain.negative? ? "text-destructive" : "text-success" %>"><%= format_money(fund.gain) %></span>
                <% if fund.return_ratio %>
                  <span class="block text-secondary"><%= number_to_percentage(fund.return_ratio * 100, precision: 2) %></span>
                <% end %>
              <% else %>
                —
              <% end %>
            <% end %>
            <% table.with_column("", align: :right) do |fund| %>
              <%= render DS::Link.new(icon: "pencil", variant: :icon, size: :sm, href: edit_investment_fund_path(fund), frame: :modal, aria: { label: t(".edit_fund", fund: fund.name) }) %>
            <% end %>
          <% end %>
          <% if overview.any_stale_fund? %>
            <p class="text-xs text-warning"><%= t(".stale_prices") %></p>
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <% overview.rows.each do |row| %>
      <% holdings = row.holdings %>
      <% next if holdings.empty? %>
      <div class="rounded-xl bg-container shadow-border-xs p-4 space-y-2">
        <p class="text-xs text-secondary"><%= t(".holdings", account: row.account.name) %></p>
        <% holdings.each do |holding| %>
          <div class="flex justify-between gap-3 text-sm">
            <span class="truncate text-primary"><%= holding.name %></span>
            <span class="shrink-0 text-primary privacy-sensitive whitespace-nowrap font-amount font-semibold"><%= format_money(holding.amount_money) %></span>
          </div>
        <% end %>
      </div>
    <% end %>
  <% end %>

  <%= render DS::Link.new(text: t(".add"), icon: "plus", variant: :outline, href: new_investment_path, frame: :modal) %>
</div>
