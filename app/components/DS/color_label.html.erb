<%= tag.span class: container_classes, title: full_title do %>
  <% if mark == :dot %>
    <span class="<%= dot_classes %>" style="background-color: <%= color %>;" aria-hidden="true"></span>
  <% elsif mark == :square %>
    <span class="<%= square_classes %>" style="<%= square_style %>" aria-hidden="true">
      <%= helpers.icon(icon || "shapes", size: icon_size, color: "current") %>
    </span>
  <% end %>
  <% if show_label %>
    <%= tag.span class: ("min-w-0 truncate" if truncate), data: (label_testid ? { testid: label_testid } : nil) do %><%= label %><% if detail %><span class="text-secondary text-xs"> · <%= detail %></span><% end %><% end %>
  <% else %>
    <span class="sr-only"><%= full_title %></span>
  <% end %>
<% end %>
