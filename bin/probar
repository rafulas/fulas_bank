#!/usr/bin/env bash
# Starts Fulas Bank for a trial run (used by the "Probar Fulas Bank"
# Codespace, see .devcontainer/probar). Prepares the database, loads the demo
# family once, then runs the web server and the background worker.
#
#   bin/probar              run in the foreground (from a terminal)
#   bin/probar --container  main process of the Codespace container: waits for
#                           the dev container setup to finish, runs the app
#                           logging to log/probar.log, and keeps the container
#                           alive if the app stops
set -uo pipefail
cd "$(dirname "$0")/.."

SETUP_DONE=tmp/.probar-setup-done

if [[ "${1:-}" == "--container" ]]; then
  mkdir -p log tmp
  {
    echo "Esperando a que termine la instalación del Codespace…"
    until [[ -f "$SETUP_DONE" ]] && bundle check > /dev/null 2>&1; do
      sleep 10
    done
    "$0"
    echo "Fulas Bank se ha detenido. Para arrancarlo de nuevo: bin/probar"
  } >> log/probar.log 2>&1
  exec sleep infinity
fi

set -e

if pgrep -f "foreman start -f Procfile.dev" > /dev/null; then
  echo "Fulas Bank ya está en marcha. Ábrelo desde la pestaña Puertos (3000)."
  exit 0
fi

bin/rails db:prepare

marker=tmp/.probar-demo-loaded
if [[ ! -f "$marker" ]]; then
  echo "Cargando datos de ejemplo (solo la primera vez, tarda unos minutos)…"
  SKIP_CLEAR=1 bin/rails demo_data:default
  mkdir -p tmp && touch "$marker"
fi

bin/rails tailwindcss:build
echo "Fulas Bank listo en el puerto 3000."
exec foreman start -f Procfile.dev
